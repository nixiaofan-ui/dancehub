<view class="nav" style="padding-top: {{statusBarHeight}}px" bindtap="onNavTap">
  <view class="nav-inner" style="height: {{navBarHeight}}px">
    <view class="nav-left">
      <view wx:if="{{showBack}}" class="nav-back" catchtap="onBack">‹</view>
      <view class="nav-tag"></view>
      <view class="nav-logo {{accent ? 'accent' : ''}}">{{title}}</view>
    </view>
    <view wx:if="{{showAvatar}}" class="nav-avatar" catchtap="onAvatar">我</view>
  </view>
</view>