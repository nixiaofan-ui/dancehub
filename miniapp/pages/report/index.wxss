.body {
  padding: 20rpx 24rpx 60rpx;
}
.intro {
  font-size: 24rpx;
  color: #a8adc2;
  line-height: 1.7;
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-left: 8rpx solid #00f5d4;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  font-weight: 700;
}

.form {
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 8rpx 24rpx 24rpx;
}
.field {
  padding: 20rpx 0 0;
}
.label {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 900;
  margin-bottom: 12rpx;
}
.req {
  color: #ff6b35;
}
.input {
  width: 100%;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-weight: 700;
}
.input.area {
  height: 160rpx;
  line-height: 1.6;
}
.ph {
  color: #6b7089;
  font-weight: 700;
}

.submit {
  margin-top: 32rpx;
  font-size: 30rpx;
  color: #0e0e1c;
  background: linear-gradient(135deg, #00f5d4, #00d9ff);
  border-radius: 44rpx;
  line-height: 2.4;
  font-weight: 900;
}
.submit.busy {
  opacity: 0.6;
}
