.body {
  padding: 24rpx 24rpx 80rpx;
}

/* ===== 品牌块 ===== */
.brand {
  text-align: center;
  padding: 40rpx 0 32rpx;
}
.brand-logo {
  width: 128rpx;
  height: 128rpx;
  line-height: 128rpx;
  margin: 0 auto 20rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #00f5d4, #00b8ff);
  color: #10212e;
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}
.brand-name {
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}
.brand-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #a8adc2;
  font-weight: 700;
}
.brand-ver {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #6b7089;
  font-weight: 700;
}

/* ===== tab ===== */
.tabs {
  display: flex;
  background: #16213e;
  border-radius: 24rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  font-weight: 900;
  color: #a8adc2;
  border-radius: 18rpx;
  letter-spacing: 2rpx;
}
.tab.on {
  background: rgba(0, 245, 212, 0.15);
  color: #00f5d4;
}

/* ===== 卡片 ===== */
.card {
  background: #16213e;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.3);
}
.card-title {
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
  color: #ffffff;
}
.card-title::before {
  content: "";
  display: inline-block;
  width: 8rpx;
  height: 26rpx;
  background: #00f5d4;
  border-radius: 4rpx;
  margin-right: 14rpx;
  vertical-align: -2rpx;
}

/* ===== 行 ===== */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}
.row-k {
  font-size: 25rpx;
  color: #a8adc2;
  font-weight: 700;
}
.row-v {
  font-size: 25rpx;
  font-weight: 800;
  text-align: right;
}
.row-v.accent {
  color: #00f5d4;
}
.row-v.pending {
  color: #ff6b35;
}

/* ===== 文本 ===== */
.para {
  font-size: 24rpx;
  line-height: 1.7;
  color: #c8ccdd;
  font-weight: 500;
  margin-bottom: 14rpx;
  text-align: justify;
}
.para:last-child {
  margin-bottom: 0;
}
.hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #6b7089;
  font-weight: 500;
}

/* ===== 按钮 ===== */
.link-btn {
  margin-top: 20rpx;
  background: transparent;
  color: #00f5d4;
  border: 2rpx solid #00f5d4;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  padding: 14rpx 0;
  line-height: 1.6;
}
