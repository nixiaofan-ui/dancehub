<nav-bar title="{{multiMode ? multiTitle : '课表'}}" show-back="{{true}}" bind:top="onNavTop" />

<view class="body">
  <!-- 多店视图：门店 chips，可多选，下方课表实时跟着变 -->
  <view wx:if="{{multiMode}}" class="multi-head">
    <view class="multi-row">
      <view class="multi-sub">勾选门店，同屏对比它们当天的课</view>
      <view class="multi-acts">
        <!-- 多店页只有「看课」，没有单独的关注入口 → 想长期只看某家分店时无处下手 -->
        <view class="multi-act" hover-class="press" bindtap="goBranches">关注分店</view>
        <view class="multi-all {{allOn ? 'is-clear' : ''}}" hover-class="press" bindtap="tapAllStores">
          {{allOn ? '清除' : '全选'}}
        </view>
      </view>
    </view>
    <scroll-view scroll-x class="store-bar" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{stores}}"
        wx:key="id"
        class="store-chip {{item.on ? 'on' : ''}}"
        hover-class="press"
        data-id="{{item.id}}"
        bindtap="tapStore"
      >
        {{item.short}}
        <text class="sc-count">{{item.count}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 单店视图：舞室头 -->
  <view wx:else class="studio-head">
    <view class="head-info">
      <view class="head-name">{{studio ? studio.name : '加载中…'}}</view>
      <view class="head-meta">{{studio ? studio.cityName + ' · ' + studio.platformLabel : ''}}</view>
    </view>
    <button
      class="head-follow {{followed ? 'followed' : ''}}"
      hover-class="press"
      bindtap="toggleFollow"
    >{{followed ? '已关注' : '关注'}}</button>
  </view>

  <!--
    放课提醒：课表提前一周就放出来了，但真正能约是临近那几天的某个点。
    这家店几点开抢只有老学员知道 —— 与其我们瞎猜，不如让用户定「星期几 + 时刻」。
    ⚠ 真正每周都响的是手机日历的重复事件：微信订阅消息一次性消耗，
      一周一次的推送第二周就会静默失效，那种"偶尔能收到"比收不到更糟。
  -->
  <view wx:if="{{!multiMode}}" class="watch-row" hover-class="press" bindtap="openWatch">
    <view class="watch-dot"></view>
    <view class="watch-txt">
      <view class="watch-title">
        {{watch ? '每周' + watch.weekdayLabel + ' ' + watch.hhmm + ' 提醒我去约课' : '设放课提醒'}}
      </view>
      <view class="watch-sub">
        {{watch ? '手机日历每周重复响一次' : '这家店每周几点放课？到点提醒你'}}
      </view>
    </view>
    <view class="watch-arrow">›</view>
  </view>

  <!-- 放课提醒设置：星期 + 时刻 -->
  <view wx:if="{{watchOpen}}" class="wk-mask" bindtap="closeWatch">
    <view class="wk-sheet" catchtap="noop">
      <view class="wk-title">放课提醒</view>
      <view class="wk-sub">{{studio ? studio.name : ''}}</view>
      <view class="wk-row">
        <picker mode="selector" range="{{weekdayRange}}" value="{{watchWeekday}}" bindchange="onWatchWeekday">
          <view class="wk-pick">
            <view class="wk-pick-label">星期</view>
            <view class="wk-pick-val">{{watchWeekdayLabel}}</view>
          </view>
        </picker>
        <picker mode="time" value="{{watchTime}}" bindchange="onWatchTime">
          <view class="wk-pick">
            <view class="wk-pick-label">时刻</view>
            <view class="wk-pick-val">{{watchTime}}</view>
          </view>
        </picker>
      </view>
      <view class="wk-tip">微信推送是一次性的，所以这条走手机日历：设好之后每周重复响，不用续。</view>
      <view class="wk-switch">
        <view class="wk-switch-txt">
          <view class="wk-switch-title">写进手机日历</view>
          <view class="wk-switch-sub">不消耗推送额度，没网也会响</view>
        </view>
        <switch checked="{{watchSyncCal}}" bindchange="onWatchSyncCal" color="#00F5D4" />
      </view>
      <view wx:if="{{watchSyncCal}}" class="wk-cal-hint">{{calHint}}</view>
      <view class="wk-actions">
        <button class="wk-btn ghost" hover-class="press" bindtap="closeWatch">取消</button>
        <button wx:if="{{watch}}" class="wk-btn del" hover-class="press" bindtap="removeWatch" disabled="{{watchBusy}}">关掉</button>
        <button class="wk-btn main" hover-class="press" bindtap="saveWatch" disabled="{{watchBusy}}">{{watch ? '改时间' : '设好'}}</button>
      </view>
    </view>
  </view>

  <!--
    舞种筛选：一家店一周几十节课，常常只想看某一类（「这家店的 Kpop 都在哪天」）。
    在门店条之后，两级串起来用：先选哪家分店，再选看什么舞种。
    统计的是整周的课，所以左右翻日期时筛选条不会变。
    认不出舞种的课归到「其它」，不会被悄悄筛掉。
  -->
  <view wx:if="{{showStyleBar}}" class="style-filter">
    <scroll-view scroll-x class="style-scroll" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{styleChips}}"
        wx:key="label"
        class="stf-chip {{item.on ? 'on' : ''}}"
        hover-class="press"
        data-label="{{item.label}}"
        bindtap="tapStyleChip"
      >{{item.label}}<text class="stf-n">{{item.count}}</text></view>
    </scroll-view>
    <!-- 全选 / 清除 二合一，和上面的门店条同款按钮 -->
    <view class="stf-all {{styleAllOn ? 'is-clear' : ''}}" hover-class="press" bindtap="tapAllStyles">
      {{styleAllOn ? '清除' : '全选'}}
    </view>
  </view>

  <!-- 星期横条 -->
  <view class="week-nav">
    <view class="week-arrow" hover-class="press" bindtap="prevWeek">‹</view>
    <swiper
      class="week-swiper"
      current="{{weekIndex}}"
      duration="200"
      bindchange="onWeekChange"
    >
      <swiper-item wx:for="{{weekSlots}}" wx:key="*this">
        <view class="week-days">
          <view
            wx:for="{{weekDays}}"
            wx:for-item="d"
            wx:key="key"
            class="week-day {{d.isToday ? 'today' : ''}} {{selectedKey === d.key ? 'on' : ''}}"
            hover-class="press"
            data-key="{{d.key}}"
            bindtap="selectDay"
          >
            <view class="wd-label">{{d.label}}</view>
            <view class="wd-num">{{d.num}}</view>
            <view class="wd-dot {{d.hasClass ? 'has' : ''}} {{d.bookedCount ? 'booked' : ''}}"></view>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <view class="week-arrow" hover-class="press" bindtap="nextWeek">›</view>
  </view>

  <!-- 选中日标题 -->
  <view class="week-bar">
    <view class="week-title">
      {{selectedTitle}}
      <text wx:if="{{bookedCount > 0}}" class="booked-chip">已约 {{bookedCount}} 节</text>
    </view>
    <view class="today-btn" hover-class="press" bindtap="goToday">今天</view>
  </view>

  <!-- 课程块 -->
  <view class="day-list">
    <view wx:if="{{!loading && bookedCount > 0}}" class="booked-hint">✅ 带「已约」标记的是你预约过的课，点进去可以取消</view>
    <view wx:if="{{loading}}" class="empty-tip">课表加载中…</view>
    <!-- 全不选：列表必然是空的，得说清楚是「没勾门店」而不是「没课」，否则会以为接口坏了 -->
    <view wx:elif="{{multiMode && activeStoreIds.length === 0}}" class="empty-tip">
      未勾选门店
      <view class="empty-sub">点上方「全选」，或直接点想看的门店</view>
    </view>
    <view wx:elif="{{dayItems.length === 0 && styleFilteredOut}}" class="empty-tip">
      这天没有你选的舞种
      <view class="empty-sub">点上方「全选」恢复，或换一天看看</view>
    </view>
    <view wx:elif="{{dayItems.length === 0}}" class="empty-tip">当天暂无课程</view>
    <view
      wx:for="{{dayItems}}"
      wx:key="id"
      class="course-card {{item.diffClass}} {{item.booked ? 'booked' : ''}}"
      hover-class="press"
      data-id="{{item.id}}"
      bindtap="goCourse"
    >
      <view class="c-time">{{item.timeLabel}}</view>
      <view class="c-main">
        <view class="c-name-row">
          <view class="c-name">{{item.courseName}}</view>
          <view wx:if="{{item.booked}}" class="c-booked">✅ 已约</view>
        </view>
        <view class="c-meta-row">
          <view
            class="c-coach {{item.coachName && item.coachName !== '待定' ? 'link' : ''}}"
            hover-class="press"
            data-name="{{item.coachName}}"
            data-city-id="{{studio.cityId}}"
            bindtap="goCoach"
          >教练：{{item.coachName}}</view>
          <view wx:if="{{multiMode}}" class="c-store-tag">{{item.studioShort}}</view>
          <view wx:if="{{item.bookedNum > 0}}" class="c-hot">🔥{{item.bookedNum}}人<text wx:if="{{item.bookedAgo}}" class="c-hot-ago"> · {{item.bookedAgo}}</text></view>
        </view>
      </view>
      <view class="c-level">
        <view class="lv-text">{{item.level}}</view>
        <view class="lv-diff">{{item.diffLabel}}</view>
      </view>
      <view wx:if="{{item.hidden}}" class="c-hidden-tip">已屏蔽</view>
    </view>

    <!-- 被屏蔽的老师：课不消失，折叠成一行，点开可临时看 / 去老师页取消 -->
    <view
      wx:for="{{foldedRows}}"
      wx:key="coachName"
      class="fold-row {{item.open ? 'open' : ''}}"
      hover-class="press"
      data-name="{{item.coachName}}"
      bindtap="toggleFold"
    >
      <view class="fr-text">已隐藏「{{item.coachName}}」的 {{item.count}} 节课</view>
      <view class="fr-btn">{{item.open ? '收起' : '展开'}}</view>
    </view>
  </view>
</view>

<toast id="toast" />
