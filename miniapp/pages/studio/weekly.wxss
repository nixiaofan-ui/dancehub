.body {
  padding: 20rpx 24rpx 40rpx;
}

/* 舞室头 */
.studio-head {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  border: 2rpx solid #2b3050;
  border-left: 10rpx solid #ff6b35;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

/* ── 放课提醒（门店粒度） ──
   橙色系：和「开课提醒」的青色分开，这是两件事，别让用户看混 */
.watch-row {
  display: flex;
  align-items: center;
  background: rgba(255, 107, 53, 0.08);
  border: 2rpx solid rgba(255, 107, 53, 0.35);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.watch-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff6b35;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.watch-txt {
  flex: 1;
  min-width: 0;
}
.watch-title {
  font-size: 27rpx;
  font-weight: 900;
  color: #ff8a5c;
  line-height: 1.35;
}
.watch-sub {
  font-size: 21rpx;
  color: #6b7391;
  line-height: 1.4;
  margin-top: 4rpx;
}
.watch-arrow {
  font-size: 34rpx;
  color: #ff8a5c;
  margin-left: 12rpx;
}

/* 放课提醒弹层（复用详情页弹层那套观感，但类名隔开，两个页面各自维护） */
.wk-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.62);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.wk-sheet {
  width: 100%;
  box-sizing: border-box;
  background: #1f2033;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
}
.wk-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #ffffff;
}
.wk-sub {
  font-size: 24rpx;
  color: #7f88a3;
  margin-top: 8rpx;
}
.wk-row {
  display: flex;
  margin-top: 24rpx;
}
/* ⚠ picker 里是原生控件，必须给明确高度：只写 padding 在真机上会被压成一条线 */
.wk-pick {
  height: 96rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid #2b3050;
  border-radius: 18rpx;
  padding: 0 24rpx;
  margin-right: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.wk-pick-label {
  font-size: 21rpx;
  color: #6b7391;
  line-height: 1.2;
}
.wk-pick-val {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 900;
  line-height: 1.3;
  margin-top: 4rpx;
}
.wk-tip {
  font-size: 22rpx;
  color: #6b7391;
  line-height: 1.6;
  margin-top: 20rpx;
}
.wk-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 18rpx;
}
.wk-switch-txt {
  flex: 1;
  margin-right: 20rpx;
}
.wk-switch-title {
  font-size: 27rpx;
  color: #ffffff;
  font-weight: 700;
  line-height: 1.3;
}
.wk-switch-sub {
  font-size: 21rpx;
  color: #6b7391;
  line-height: 1.4;
  margin-top: 6rpx;
}
/* ⚠ iOS 日历权限必须选「完全访问」，只选「仅添加事件」不写入也不报错 → 提前写出来 */
.wk-cal-hint {
  font-size: 21rpx;
  color: #ff9e6b;
  line-height: 1.55;
  margin-top: 14rpx;
}
.wk-actions {
  display: flex;
  margin-top: 28rpx;
}
.wk-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 900;
  margin-right: 16rpx;
}
.wk-btn:last-child {
  margin-right: 0;
}
.wk-btn.ghost {
  background: transparent;
  color: #a8adc2;
  border: 2rpx solid #2b3050;
}
.wk-btn.del {
  background: transparent;
  color: #ff6b6b;
  border: 2rpx solid rgba(255, 107, 107, 0.45);
}
.wk-btn.main {
  background: linear-gradient(135deg, #ff6b35, #ff8a5c);
  color: #ffffff;
}
.head-info {
  flex: 1;
  min-width: 0;
}
.head-name {
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}
.head-meta {
  font-size: 24rpx;
  color: #a8adc2;
  margin-top: 6rpx;
  font-weight: 700;
}
.head-follow {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #00f5d4;
  background: transparent;
  border: 2rpx solid #00f5d4;
  border-radius: 32rpx;
  padding: 8rpx 28rpx;
  line-height: 1.8;
  font-weight: 900;
}
.head-follow.followed {
  color: #0e0e1c;
  background: #00f5d4;
  border-color: #00f5d4;
}

/* 舞种筛选条：与首页 index 那套是同一份样式，改一处要同步改另一处 */
.style-filter {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.style-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}
.stf-chip {
  display: inline-block;
  padding: 8rpx 22rpx;
  margin-right: 12rpx;
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #aaaaaa;
  font-weight: 700;
}
/* 用青色区分于门店条的橙色：两条筛选条并排，颜色一样会分不清哪个是哪个 */
.stf-chip.on {
  background: rgba(0, 245, 212, 0.14);
  border-color: rgba(0, 245, 212, 0.5);
  color: #00f5d4;
  font-weight: 900;
}
.stf-n {
  font-size: 20rpx;
  margin-left: 8rpx;
  opacity: 0.65;
  font-weight: 700;
}
.stf-all {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #00f5d4;
  border: 1rpx solid rgba(0, 245, 212, 0.45);
  border-radius: 24rpx;
  padding: 6rpx 20rpx;
  margin-left: 12rpx;
  font-weight: 700;
}
/* 全选状态下这颗按钮变成「清除」：换中性色，同一个青色按钮来回变字
   会让人以为点了没生效（和分店条那颗同款处理） */
.stf-all.is-clear {
  color: #a8adc2;
  border-color: rgba(168, 173, 194, 0.5);
  background: rgba(168, 173, 194, 0.12);
}

/* 星期横条 */
.week-nav {
  display: flex;
  align-items: center;
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 10rpx 12rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.3);
}
.week-arrow {
  width: 56rpx;
  height: 88rpx;
  border-radius: 12rpx;
  color: #00f5d4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #ff6b35;
  font-weight: 900;
  flex-shrink: 0;
}
.week-swiper {
  flex: 1;
  height: 112rpx;
}
.week-days {
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  height: 112rpx;
}
.week-day {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 6rpx;
  border-radius: 12rpx;
  background: #1a1a2e;
  border: 2rpx solid rgba(255, 255, 255, 0.05);
}
.week-day.today {
  border-color: #00f5d4;
}
.week-day.on {
  background: #00f5d4;
  border-color: #00f5d4;
}
.week-day.on .wd-label,
.week-day.on .wd-num {
  color: #ffffff;
}
.wd-label {
  font-size: 22rpx;
  font-weight: 900;
  color: #a8adc2;
  letter-spacing: 2rpx;
}
.wd-num {
  font-size: 30rpx;
  font-weight: 900;
  margin-top: 4rpx;
}
.wd-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-top: 6rpx;
  background: transparent;
}
.wd-dot.has {
  background: #00f5d4;
  box-shadow: 0 0 8rpx rgba(0, 245, 212, 0.7);
}
.week-day.on .wd-dot.has {
  background: #00f5d4;
  box-shadow: 0 0 8rpx rgba(0, 245, 212, 0.7);
}
/* 这天有「我的预约」：橙色比青色更抓眼，和「有课」区分开 */
.wd-dot.booked {
  width: 14rpx;
  height: 14rpx;
  background: #ff6b35;
  box-shadow: 0 0 10rpx rgba(255, 107, 53, 0.9);
}
.week-day.on .wd-dot.booked {
  width: 14rpx;
  height: 14rpx;
  background: #ff6b35;
  box-shadow: 0 0 10rpx rgba(255, 107, 53, 0.9);
}

/* 选中日标题 */
.week-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.week-title {
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}
.booked-chip {
  display: inline-block;
  margin-left: 16rpx;
  font-size: 22rpx;
  font-weight: 900;
  color: #00f5d4;
  background: rgba(0, 245, 212, 0.14);
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
}
.today-btn {
  font-size: 24rpx;
  font-weight: 900;
  color: #ffffff;
  background: linear-gradient(135deg, #ff6b35, #ff8a5c);
  border-radius: 28rpx;
  padding: 8rpx 26rpx;
}

/* 课程块 */
.day-list {
  padding-top: 4rpx;
}
.course-card {
  display: flex;
  align-items: center;
  background: #1a1a2e;
  border-left: 10rpx solid #ff6b35;
  border-radius: 24rpx;
  padding: 22rpx 20rpx;
  margin-bottom: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
  border-right: 1rpx solid rgba(255, 255, 255, 0.05);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.3);
}
.course-card.beginner {
  border-left-color: #00f5d4;
}
.course-card.intermediate {
  border-left-color: #ff6b35;
}
.course-card.advanced {
  border-left-color: #7b2fbe;
}
.course-card.all_levels {
  border-left-color: #a8adc2;
}
/* 已预约：难度色仍留在左边条上，用青色描边 + 徽标标「这是我约的」 */
.course-card.booked {
  border-top-color: rgba(0, 245, 212, 0.45);
  border-right-color: rgba(0, 245, 212, 0.45);
  border-bottom-color: rgba(0, 245, 212, 0.45);
  box-shadow: 0 8rpx 40rpx rgba(0, 245, 212, 0.14);
}
.booked-hint {
  font-size: 22rpx;
  font-weight: 700;
  color: #00f5d4;
  background: rgba(0, 245, 212, 0.08);
  border-radius: 12rpx;
  padding: 12rpx 18rpx;
  margin-bottom: 16rpx;
}
.c-time {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 900;
  color: #00f5d4;
  letter-spacing: 1rpx;
}
.c-main {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
}
.c-name-row {
  display: flex;
  align-items: center;
}
.c-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.c-booked {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 900;
  color: #00f5d4;
  background: rgba(0, 245, 212, 0.14);
  border: 1rpx solid rgba(0, 245, 212, 0.45);
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
}
/* 多店视图：门店 chips */
.multi-head {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  border: 2rpx solid #2b3050;
  border-left: 10rpx solid #00f5d4;
  border-radius: 16rpx;
  padding: 20rpx 0 16rpx;
  margin-bottom: 20rpx;
}
.multi-row {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  margin-bottom: 14rpx;
}
.multi-sub {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #a8adc2;
  font-weight: 700;
}
/* 「关注分店」与「全选/清除」并排：靠右对齐，中间留 16rpx，
   贴太近用户会以为它们是同一个按钮 */
.multi-acts {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}
.multi-act {
  font-size: 24rpx;
  color: #a8adc2;
  border: 2rpx solid rgba(168, 173, 194, 0.55);
  border-radius: 28rpx;
  padding: 6rpx 20rpx;
  font-weight: 900;
  margin-right: 16rpx;
}
.multi-all {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #00f5d4;
  border: 2rpx solid #00f5d4;
  border-radius: 28rpx;
  padding: 6rpx 24rpx;
  font-weight: 900;
}

/* 已经全选时这个按钮变成「清除」：换个颜色，否则同一个青色按钮
   在「全选」和「清除」之间来回变字，用户会以为点了没生效 */
.multi-all.is-clear {
  color: #ff7a8a;
  border-color: #ff7a8a;
}
.store-bar {
  white-space: nowrap;
  padding: 0 24rpx;
}
.store-chip {
  display: inline-block;
  font-size: 26rpx;
  color: #a8adc2;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 32rpx;
  padding: 10rpx 24rpx;
  margin-right: 14rpx;
  font-weight: 700;
}
.store-chip.on {
  color: #0e0e1c;
  background: #00f5d4;
  border-color: #00f5d4;
}
.sc-count {
  font-size: 20rpx;
  margin-left: 8rpx;
  opacity: 0.7;
}

/* 课卡片上的门店标签（多店视图才有） */
.c-meta-row {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}
.c-coach {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #a8adc2;
  margin-top: 0;
  font-weight: 700;
}
/* 有教练名时可点 → 老师主页，用颜色区分于「待定」 */
.c-coach.link {
  color: #cfd3e6;
  text-decoration: underline;
  text-decoration-color: rgba(207, 211, 230, 0.35);
}
.c-store-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #ff9f6b;
  background: rgba(255, 107, 53, 0.12);
  border: 1rpx solid rgba(255, 107, 53, 0.3);
  border-radius: 8rpx;
  padding: 3rpx 12rpx;
  margin-left: 12rpx;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 700;
}
.c-level {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 12rpx;
  padding: 8rpx 18rpx;
}
.course-card.beginner .lv-text {
  color: #00f5d4;
}
.course-card.intermediate .lv-text {
  color: #ff6b35;
}
.course-card.advanced .lv-text {
  color: #b18cff;
}
.course-card.all_levels .lv-text {
  color: #a8adc2;
}
.lv-text {
  font-size: 28rpx;
  font-weight: 900;
}
.lv-diff {
  font-size: 20rpx;
  color: #a8adc2;
  margin-top: 2rpx;
  font-weight: 700;
}
.empty-tip {
  text-align: center;
  color: #a8adc2;
  padding: 80rpx 0;
  font-size: 26rpx;
  font-weight: 700;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #6f7488;
}

/* 被屏蔽老师的折叠行：不彻底消失，留一行证明设置生效 + 给反悔入口 */
.fold-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  margin-top: 16rpx;
  border-radius: 16rpx;
  background: rgba(168, 173, 194, 0.08);
  border: 2rpx dashed rgba(168, 173, 194, 0.45);
}
.fold-row.open {
  border-style: solid;
  border-color: rgba(0, 245, 212, 0.5);
}
.fr-text {
  font-size: 24rpx;
  color: #a8adc2;
  font-weight: 700;
}
.fr-btn {
  font-size: 22rpx;
  color: #00f5d4;
  font-weight: 900;
  padding-left: 16rpx;
}
.c-hidden-tip {
  font-size: 18rpx;
  color: #ff6b35;
  font-weight: 900;
  margin-top: 6rpx;
}

/* 真实约课人数热度标：来自舞室官方系统，不是本小程序用户数 */
.c-hot {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #ff6b35;
  font-weight: 900;
  margin-left: 10rpx;
}
/* 数据新鲜度：上面那个数字是抓取快照，标一句「多久前」 */
.c-hot-ago {
  font-size: 18rpx;
  color: #a8adc2;
  font-weight: 400;
}
