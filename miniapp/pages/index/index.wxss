.body {
  padding: 20rpx 24rpx 220rpx;
}

/* 地区切换（半透明胶囊） */
.region-row {
  display: flex;
  justify-content: center;
  margin-bottom: 18rpx;
}
.seg {
  display: flex;
  background: rgba(26, 26, 46, 0.7);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 40rpx;
  padding: 6rpx;
  backdrop-filter: blur(20rpx);
}
.seg-item {
  padding: 10rpx 48rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #aaaaaa;
  font-weight: 700;
}
.seg-item.on {
  background: linear-gradient(135deg, #ff6b35, #ff8a5c);
  color: #ffffff;
  font-weight: 900;
}

/* 城市 */
.city-bar {
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.chip {
  display: inline-block;
  padding: 10rpx 32rpx;
  margin-right: 16rpx;
  background: #16213e;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #aaaaaa;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  font-weight: 700;
}
.chip.on {
  background: linear-gradient(135deg, #7b2fbe, #9b5cff);
  color: #ffffff;
  border-color: #7b2fbe;
  font-weight: 900;
}
/* 定位入口：跟城市 chip 区分开，摆在横滑条最前面 */
.chip-locate {
  background: rgba(0, 245, 212, 0.12);
  border-color: rgba(0, 245, 212, 0.45);
  color: #00f5d4;
}
.chip-locate.busy {
  opacity: 0.6;
}
/* 「全部城市」入口：虚线描边，区别于「选中城市」的实心 chip */
.chip-all {
  background: transparent;
  border: 1rpx dashed rgba(155, 92, 255, 0.55);
  color: #b98cff;
  margin-right: 0;
}
.ca-caret {
  margin-left: 6rpx;
  font-size: 22rpx;
  position: relative;
  top: -2rpx;
}

/* 已关注门店筛选条 */
.store-filter {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.store-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}
.sf-chip {
  display: inline-block;
  padding: 8rpx 22rpx;
  margin-right: 12rpx;
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #aaaaaa;
  font-weight: 700;
}
.sf-chip.on {
  background: rgba(255, 107, 53, 0.16);
  border-color: rgba(255, 107, 53, 0.5);
  color: #ff9f6b;
  font-weight: 900;
}
.sf-n {
  font-size: 20rpx;
  margin-left: 8rpx;
  opacity: 0.65;
  font-weight: 700;
}
.sf-all {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #00f5d4;
  border: 1rpx solid rgba(0, 245, 212, 0.45);
  border-radius: 24rpx;
  padding: 6rpx 20rpx;
  margin-left: 12rpx;
  font-weight: 700;
}
/* 全选态下这颗按钮变成「清除」：换个中性色，同一个青色按钮来回变字
   会被看成点了没反应（与舞种条同款处理） */
.sf-all.is-clear {
  color: #a8adc2;
  border-color: rgba(168, 173, 194, 0.5);
  background: rgba(168, 173, 194, 0.12);
}

/* 舞种筛选条：和上面的门店条是两级独立筛选（先选店、再看教什么） */
.style-filter {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.style-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}
.stf-chip {
  display: inline-block;
  padding: 8rpx 22rpx;
  margin-right: 12rpx;
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #aaaaaa;
  font-weight: 700;
}
/* 用青色区分于门店条的橙色：两条筛选条并排，颜色一样会分不清哪个是哪个 */
.stf-chip.on {
  background: rgba(0, 245, 212, 0.14);
  border-color: rgba(0, 245, 212, 0.5);
  color: #00f5d4;
  font-weight: 900;
}
.stf-n {
  font-size: 20rpx;
  margin-left: 8rpx;
  opacity: 0.65;
  font-weight: 700;
}
.stf-all {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #00f5d4;
  border: 1rpx solid rgba(0, 245, 212, 0.45);
  border-radius: 24rpx;
  padding: 6rpx 20rpx;
  margin-left: 12rpx;
  font-weight: 700;
}
/* 全选状态下这颗按钮变成「清除」：换中性色，同一个青色按钮来回变字
   会让人以为点了没生效（和分店条那颗同款处理） */
.stf-all.is-clear {
  color: #a8adc2;
  border-color: rgba(168, 173, 194, 0.5);
  background: rgba(168, 173, 194, 0.12);
}

/* 屏蔽提示条：藏了什么必须让用户知道，还要能一键反悔 */
.hidden-strip {
  font-size: 22rpx;
  color: #a8adc2;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 10rpx 22rpx;
  margin-bottom: 16rpx;
  text-align: center;
  font-weight: 700;
}
.hidden-strip.on {
  color: #ff9f6b;
  border-color: rgba(255, 107, 53, 0.35);
  background: rgba(255, 107, 53, 0.1);
}

/* 提醒条 */
.reminder-strip {
  margin-bottom: 16rpx;
  padding: 18rpx 24rpx;
  background: linear-gradient(90deg, #00f5d4, #00d9ff);
  color: #0e0e1c;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

/*
  只看已约：做成开关而不是又一个 chip，是因为它和门店/舞种筛选不是一类东西 ——
  那两条是「从全部课里挑」，这条是「换一种视角」。
*/
.booked-filter {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}
.bf-toggle {
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #a8adc2;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}
.bf-toggle.on {
  color: #0e0e1c;
  background: linear-gradient(135deg, #00f5d4, #00d9ff);
  border-color: transparent;
}
.bf-count {
  margin-left: 14rpx;
  font-size: 21rpx;
  font-weight: 600;
  color: #79819c;
}

/* 日期 */
.date-nav {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #aaaaaa;
  font-weight: 900;
}
/* 补录入口：和左右箭头同一排，但给它一个实心底色 ——
   它是「往里加东西」的动作，不该跟翻页这种浏览动作长得一样 */
.add-day {
  width: 64rpx;
  height: 64rpx;
  margin-left: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #0e0e1c;
  background: #00f5d4;
  border-radius: 20rpx;
  font-weight: 900;
}
/* 空态里的补录入口：做成文字链接而不是第二个黄按钮 ——
   两个主按钮并排，用户反而不知道该点哪个 */
.empty-alt {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #00f5d4;
  font-weight: 700;
  padding: 12rpx 24rpx;
}
.date-swiper {
  flex: 1;
  height: 96rpx;
}
.date-item {
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #16213e;
  margin: 0 6rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}
.date-item.cur {
  background: linear-gradient(135deg, #ff6b35, #ff8a5c);
  border-color: #ff6b35;
}
.date-item.today .date-day {
  color: #00f5d4;
}
.date-item.cur .date-day,
.date-item.cur .date-num {
  color: #ffffff;
}
.date-day {
  font-size: 24rpx;
  font-weight: 700;
  color: #aaaaaa;
}
.date-num {
  font-size: 30rpx;
  font-weight: 900;
  margin-top: 2rpx;
}

/* 时间轴 */
.timeline {
  padding-top: 8rpx;
}
.row {
  display: flex;
}
/*
  明暗分配：**已约的课最亮，没约的让位**。
  原来是反过来的（未约亮、已约压到 0.6）—— 而这张表的高频问题是
  「我约的那节在几点」，被压暗的恰恰是最该一眼看到的那些。
  三档：已约好（青）> 待确认（紫）> 未约（压暗但仍可读）。
*/
.row.booked {
  opacity: 1;
}
.row.booked .card {
  background: #1a2a4e;
  border-left-color: #00f5d4;
  box-shadow: 0 8rpx 40rpx rgba(0, 245, 212, 0.16);
}
/* 待确认：用户主动标过，比未约更靠前，但还没落地 → 中间亮度 + 紫色呼应按钮 */
.row.pending {
  opacity: 0.92;
}
.row.pending .card {
  border-left-color: #9b5cff;
}
.row.unbooked {
  opacity: 0.66;
}
/* 已过去的课最淡：不管约没约，都写成 `.row.past` 且放在最后覆盖上面三档 */
.row.past {
  opacity: 0.3;
}
.time-col {
  width: 118rpx;
  padding-top: 26rpx;
  text-align: right;
}
.t-start {
  display: inline-block;
  background: rgba(0, 245, 212, 0.16);
  color: #00f5d4;
  font-size: 24rpx;
  font-weight: 900;
  padding: 6rpx 14rpx;
  border-radius: 24rpx;
  letter-spacing: 1rpx;
  border: 1rpx solid rgba(0, 245, 212, 0.35);
}
.t-end {
  font-size: 22rpx;
  color: #aaaaaa;
  margin-top: 6rpx;
  font-weight: 700;
}
.line {
  width: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #2b3050;
  margin-top: 32rpx;
}
.dot-booked {
  background: #00f5d4;
  box-shadow: 0 0 12rpx rgba(0, 245, 212, 0.7);
}
.dot-pending {
  background: #9b5cff;
  box-shadow: 0 0 12rpx rgba(155, 92, 255, 0.6);
}
.line-body {
  width: 2rpx;
  flex: 1;
  background: #2b3050;
}
.card {
  flex: 1;
  background: #16213e;
  border-left: 10rpx solid #ff6b35;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 8rpx 0 20rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.3);
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
  border-right: 1rpx solid rgba(255, 255, 255, 0.05);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}
.card.edge-beginner {
  border-left-color: #00f5d4;
}
.card.edge-intermediate {
  border-left-color: #ff6b35;
}
.card.edge-advanced {
  border-left-color: #7b2fbe;
}
.card.edge-all_levels {
  border-left-color: #aaaaaa;
}
.card-head {
  display: flex;
  align-items: center;
}
.studio {
  font-size: 26rpx;
  color: #ff8a5c;
  font-weight: 900;
  flex: 1;
  letter-spacing: 1rpx;
}
.remind-flag {
  font-size: 26rpx;
}
.course-name {
  font-size: 36rpx;
  font-weight: 900;
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}
.diff {
  font-size: 22rpx;
  font-weight: 900;
  color: #ffffff;
  background: #7b2fbe;
  padding: 4rpx 14rpx;
  border-radius: 24rpx;
  margin-left: 10rpx;
}
.coach {
  font-size: 24rpx;
  color: #aaaaaa;
  margin-top: 6rpx;
  font-weight: 700;
}
/* 常看的老师：整行提亮 + 星标，扫课表时一眼能挑出来 */
.coach.fav {
  color: #b18cff;
}
.fav-mark {
  margin-left: 6rpx;
  font-size: 24rpx;
  color: #b18cff;
}
.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}
.slot {
  font-size: 22rpx;
  font-weight: 900;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  letter-spacing: 1rpx;
}
.slot.ok {
  color: #00c853;
  background: rgba(0, 200, 83, 0.12);
}
.slot.warn {
  color: #ff6b35;
  background: rgba(255, 107, 53, 0.14);
}
.slot.full {
  color: #ff3b30;
  background: rgba(255, 59, 48, 0.12);
}
.btn-row {
  display: flex;
  justify-content: flex-end;
}
.btn {
  font-size: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff6b35, #ff8a5c);
  border-radius: 32rpx;
  padding: 8rpx 32rpx;
  line-height: 1.8;
  font-weight: 900;
}
.btn.pending {
  background: linear-gradient(135deg, #7b2fbe, #9b5cff);
  color: #ffffff;
}
/* 已约的标签跟着卡片一起提亮（原来是若隐若现的淡青底） */
.btn.booked {
  background: rgba(0, 245, 212, 0.22);
  color: #00f5d4;
  border: 1rpx solid rgba(0, 245, 212, 0.5);
}
.loading-tip {
  text-align: center;
  color: #aaaaaa;
  padding: 60rpx 0;
  font-weight: 700;
}

/* 行动面板 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #16213e;
  border-top: 4rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 100;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.4);
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}
.sheet-info {
  font-size: 26rpx;
  color: #aaaaaa;
  margin-top: 10rpx;
  font-weight: 700;
}
.sheet-warn {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #ff6b35;
  background: rgba(255, 107, 53, 0.14);
  padding: 12rpx;
  border-radius: 12rpx;
  font-weight: 700;
}
.sheet-actions {
  margin-top: 28rpx;
}
.action {
  width: 100%;
  margin-top: 16rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  padding: 16rpx 0;
  line-height: 1.6;
  font-weight: 900;
  letter-spacing: 2rpx;
}
.action.primary {
  background: linear-gradient(135deg, #ff6b35, #ff8a5c);
  color: #ffffff;
}
.action.secondary {
  background: transparent;
  color: #00f5d4;
  border: 2rpx solid #00f5d4;
}
.action.remind {
  background: transparent;
  color: #00f5d4;
  border: 2rpx solid rgba(0, 245, 212, 0.4);
}
/* 取消预约是破坏性操作：红色描边，和主按钮的橙、提醒的青区分开 */
.action.danger {
  background: transparent;
  color: #ff6b6b;
  border: 2rpx solid rgba(255, 107, 107, 0.45);
}

/* ===== 加载失败错误条 =====
   云托管冷启动或服务异常时，请求可能十几秒没回音。
   那时界面若只剩背景色，用户只会以为小程序坏了 —— 留一条说清原因的错误条
   并给出重试入口，比默默空白要好得多。 */
.load-error {
  margin: 24rpx 0;
  padding: 32rpx;
  background: rgba(255, 107, 107, 0.08);
  border: 2rpx solid rgba(255, 107, 107, 0.35);
  border-radius: 32rpx;
  text-align: center;
}
.le-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #ff6b6b;
  letter-spacing: 2rpx;
}
.le-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  line-height: 1.6;
  word-break: break-all;
}
.le-btn {
  margin: 24rpx auto 0;
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 900;
  color: #ff6b6b;
  border: 2rpx solid rgba(255, 107, 107, 0.5);
}
/* 真实约课热度（数据来自舞室官方系统，非本小程序用户数） */
.hot-line {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #ff6b35;
  font-weight: 900;
}
.hot-cap {
  color: #a8adc2;
  font-weight: 700;
}
/* 数据新鲜度：人数是抓取快照，得让用户知道这是几分钟前的数 */
.hot-ago {
  color: #a8adc2;
  font-size: 20rpx;
  font-weight: 400;
}
