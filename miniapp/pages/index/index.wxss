.body {
  padding: 20rpx 24rpx 220rpx;
}

/* 地区切换 */
.region-row {
  display: flex;
  justify-content: center;
  margin-bottom: 18rpx;
}
.seg {
  display: flex;
  background: #1a1a2e;
  border: 2rpx solid #ff6b35;
  border-radius: 40rpx;
  padding: 6rpx;
}
.seg-item {
  padding: 10rpx 48rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #a8adc2;
  font-weight: 700;
}
.seg-item.on {
  background: #ff6b35;
  color: #0e0e1c;
  font-weight: 900;
}

/* 城市 */
.city-bar {
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.chip {
  display: inline-block;
  padding: 10rpx 32rpx;
  margin-right: 16rpx;
  background: #16213e;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #a8adc2;
  border: 2rpx solid #2b3050;
  font-weight: 700;
}
.chip.on {
  background: #7b2fbe;
  color: #ffffff;
  border-color: #7b2fbe;
  font-weight: 900;
}

/* 提醒条 */
.reminder-strip {
  margin-bottom: 16rpx;
  padding: 18rpx 24rpx;
  background: #00f5d4;
  color: #0e0e1c;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

/* 日期 */
.date-nav {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #a8adc2;
  font-weight: 900;
}
.date-swiper {
  flex: 1;
  height: 96rpx;
}
.date-item {
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
}
.date-item.cur {
  background: #ff6b35;
  color: #0e0e1c;
}
.date-item.today .date-day {
  color: #00f5d4;
}
.date-item.cur .date-day,
.date-item.cur .date-num {
  color: #0e0e1c;
}
.date-day {
  font-size: 26rpx;
  font-weight: 700;
}
.date-num {
  font-size: 30rpx;
  font-weight: 900;
}

/* 时间轴 */
.timeline {
  padding-top: 8rpx;
}
.row {
  display: flex;
}
.past {
  opacity: 0.35;
}
.time-col {
  width: 118rpx;
  padding-top: 26rpx;
  text-align: right;
}
.t-start {
  display: inline-block;
  background: #ff6b35;
  color: #0e0e1c;
  font-size: 26rpx;
  font-weight: 900;
  padding: 6rpx 14rpx;
  border-radius: 24rpx;
  letter-spacing: 1rpx;
}
.t-end {
  font-size: 22rpx;
  color: #a8adc2;
  margin-top: 6rpx;
  font-weight: 700;
}
.line {
  width: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #2b3050;
  margin-top: 32rpx;
}
.dot-booked {
  background: #00f5d4;
}
.line-body {
  width: 2rpx;
  flex: 1;
  background: #2b3050;
}
.card {
  flex: 1;
  background: #16213e;
  border-left: 10rpx solid #ff6b35;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 8rpx 0 20rpx;
}
.card-head {
  display: flex;
  align-items: center;
}
.studio {
  font-size: 28rpx;
  color: #ff6b35;
  font-weight: 900;
  flex: 1;
  letter-spacing: 1rpx;
}
.remind-flag {
  font-size: 26rpx;
}
.course-name {
  font-size: 34rpx;
  font-weight: 900;
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}
.diff {
  font-size: 22rpx;
  font-weight: 900;
  color: #ffffff;
  background: #7b2fbe;
  padding: 4rpx 14rpx;
  border-radius: 24rpx;
  margin-left: 10rpx;
}
.coach {
  font-size: 24rpx;
  color: #a8adc2;
  margin-top: 6rpx;
  font-weight: 700;
}
.btn-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}
.btn {
  font-size: 26rpx;
  color: #0e0e1c;
  background: #ff6b35;
  border-radius: 32rpx;
  padding: 8rpx 32rpx;
  line-height: 1.8;
  font-weight: 900;
}
.btn.pending {
  background: #7b2fbe;
  color: #ffffff;
}
.btn.booked {
  background: #00f5d4;
  color: #0e0e1c;
}
.loading-tip {
  text-align: center;
  color: #a8adc2;
  padding: 60rpx 0;
  font-weight: 700;
}

/* 行动面板 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #16213e;
  border-top: 6rpx solid #ff6b35;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 100;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}
.sheet-info {
  font-size: 26rpx;
  color: #a8adc2;
  margin-top: 10rpx;
  font-weight: 700;
}
.sheet-warn {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #ff6b35;
  background: rgba(255, 107, 53, 0.14);
  padding: 12rpx;
  border-radius: 8rpx;
  font-weight: 700;
}
.sheet-actions {
  margin-top: 28rpx;
}
.action {
  width: 100%;
  margin-top: 16rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  padding: 16rpx 0;
  line-height: 1.6;
  font-weight: 900;
}
.action.primary {
  background: #ff6b35;
  color: #0e0e1c;
}
.action.secondary {
  background: #1a1a2e;
  color: #ffffff;
  border: 2rpx solid #2b3050;
}
.action.remind {
  background: transparent;
  color: #00f5d4;
  border: 2rpx solid #00f5d4;
}