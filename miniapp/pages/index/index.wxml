<nav-bar title="DanceHub" show-avatar="{{true}}" bind:avatar="goProfile" accent bind:top="onNavTop" />

<view class="body">
  <!-- 地区切换 -->
  <view class="region-row">
    <view class="seg">
      <view class="seg-item {{region === 'CN' ? 'on' : ''}}" hover-class="press" data-r="CN" bindtap="switchRegion">中国</view>
      <view class="seg-item {{region === 'OVERSEAS' ? 'on' : ''}}" hover-class="press" data-r="OVERSEAS" bindtap="switchRegion">海外</view>
    </view>
  </view>

  <!--
    城市切换：库里 100 来个城市全塞横滑条，找一个三线城要滑很久，
    改成「定位 + 8 个热门 + 全部城市面板（搜索/字母索引）」。
    当前选中的城市即便不热门也会被顶到第一位，否则切完看不到自己选的是谁。
  -->
  <scroll-view scroll-x class="city-bar" enhanced show-scrollbar="{{false}}">
    <view class="chip chip-locate {{locating ? 'busy' : ''}}" hover-class="press" bindtap="tapLocate">
      {{locating ? '定位中…' : '📍 定位'}}
    </view>
    <view
      wx:for="{{hotCities}}"
      wx:key="id"
      class="chip {{cityId === item.id ? 'on' : ''}}"
      hover-class="press"
      data-id="{{item.id}}"
      bindtap="selectCity"
    >{{item.name}}</view>
    <view class="chip chip-all" hover-class="press" bindtap="openCityPicker">
      {{cityName || '全部城市'}} · 全部<text class="ca-caret">⌄</text>
    </view>
  </scroll-view>

  <city-picker
    visible="{{cityPickerVisible}}"
    cities="{{filteredCities}}"
    cityId="{{cityId}}"
    region="{{region}}"
    locating="{{locating}}"
    bind:close="closeCityPicker"
    bind:select="onPickCity"
    bind:locate="onPickLocate"
  />

  <!-- 悬浮提醒条 -->
  <view wx:if="{{pendingCount > 0}}" class="reminder-strip" hover-class="press" bindtap="goConfirm">
    📌 您有 {{pendingCount}} 节未确认预约，记得点「我已约好」
  </view>

  <!--
    预约在别座城市的提示条。
    ⚠ 只提示、不切城市：课表停在用户所在的城市（或他自己选的城市），
      但「我约的那节课在哪」这件事不能丢 —— 给一条可点的入口，
      点一下才切过去。点 ✕ 关掉，本次会话不再出现。
  -->
  <view wx:if="{{cityHint}}" class="city-hint" hover-class="press" bindtap="tapCityHint">
    <text class="ch-text">你在{{cityHint.name}}还有 {{cityHint.count}} 节预约</text>
    <text class="ch-go">切过去 ›</text>
    <text class="ch-close" catchtap="dismissCityHint">✕</text>
  </view>

  <!-- 日期滑条 -->
  <view class="date-nav">
    <view class="arrow" hover-class="press" bindtap="prevDay">‹</view>
    <swiper class="date-swiper" current="{{swiperCurrent}}" duration="200" bindchange="onSwiperChange">
      <swiper-item wx:for="{{dates}}" wx:key="key">
        <view
          class="date-item {{item.isToday ? 'today' : ''}} {{currentKey === item.key ? 'cur' : ''}}"
          hover-class="press"
          data-key="{{item.key}}"
          bindtap="onTapDate"
        >
          <view class="date-day">{{item.isToday ? '今天' : item.day}}</view>
          <view class="date-num">{{item.date}}</view>
        </view>
      </swiper-item>
    </swiper>
    <view class="arrow" hover-class="press" bindtap="nextDay">›</view>
    <!-- 补录：就地补一节没被抓到的课，城市和上面选中的日期会自动带过去 -->
    <view class="add-day" hover-class="press" bindtap="goImport">＋</view>
  </view>

  <!--
    只看已约。
    默认关：课表的主职是「今天我能上什么」，一上来只剩已约的课，等于把它变成
    另一份预约记录。但**已约课恒定置顶**（不管开关开着还是关着）——
    一天几十节课时，「我约的那节在几点」是最高频的问题，不该让人翻。
    ⚠ 这天一节已约都没有时整行收起：一个点了只会变空的开关纯属噪音。
  -->
  <view wx:if="{{bookedCount > 0}}" class="booked-filter">
    <view class="bf-toggle {{onlyBooked ? 'on' : ''}}" hover-class="press" bindtap="toggleOnlyBooked">
      {{onlyBooked ? '✓ 只看已约' : '只看已约'}}
    </view>
    <text class="bf-count">已约 {{bookedCount}} 节 · 已置顶并高亮</text>
  </view>

  <!-- 已关注门店筛选：多家店同时看时，用它决定时间轴里出现谁 -->
  <view wx:if="{{showStoreBar}}" class="store-filter">
    <scroll-view scroll-x class="store-scroll" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{storeChips}}"
        wx:key="id"
        class="sf-chip {{item.on ? 'on' : ''}}"
        hover-class="press"
        data-id="{{item.id}}"
        bindtap="tapStoreChip"
      >{{item.short}}<text class="sf-n">{{item.count}}</text></view>
    </scroll-view>
    <view class="sf-all {{storeAllOn ? 'is-clear' : ''}}" hover-class="press" bindtap="tapAllStores">
      {{storeAllOn ? '清除' : '全选'}}
    </view>
  </view>

  <!--
    舞种筛选：关注的店多了以后，一天几十节课里往往只想看某一类
    （「今天只想跳 Jazz」）。课名里自带舞种，本地识别即可过滤。
    认不出舞种的课归到「其它」，不会被悄悄筛掉。
  -->
  <view wx:if="{{showStyleBar}}" class="style-filter">
    <scroll-view scroll-x class="style-scroll" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{styleChips}}"
        wx:key="label"
        class="stf-chip {{item.on ? 'on' : ''}}"
        hover-class="press"
        data-label="{{item.label}}"
        bindtap="tapStyleChip"
      >{{item.label}}<text class="stf-n">{{item.count}}</text></view>
    </scroll-view>
    <!-- 全选 / 清除 二合一：和分店条那颗按钮同一套行为 -->
    <view class="stf-all {{styleAllOn ? 'is-clear' : ''}}" hover-class="press" bindtap="tapAllStyles">
      {{styleAllOn ? '清除' : '全选'}}
    </view>
  </view>

  <!-- 服务不可达：不能只留一片空白，给出原因和重试入口 -->
  <view wx:if="{{loadError}}" class="load-error">
    <view class="le-title">连不上服务</view>
    <view class="le-desc">{{loadError}}</view>
    <view class="le-btn" hover-class="press" bindtap="reload">点击重试</view>
  </view>

  <!-- 时间轴 -->
  <view class="timeline" wx:if="{{!loading}}">
    <view wx:if="{{hiddenCount > 0}}" class="hidden-strip" hover-class="press" bindtap="toggleShowBlocked">
      已隐藏 {{hiddenCount}} 节不想看的课 · 点击展开
    </view>
    <view wx:if="{{showBlocked}}" class="hidden-strip on" hover-class="press" bindtap="toggleShowBlocked">
      正在显示全部课程 · 点击重新隐藏
    </view>
    <view wx:if="{{items.length === 0}}" class="empty">
      <view class="dancer-lg empty-dancer">
        <view class="d-head"></view>
        <view class="d-torso"></view>
        <view class="d-limb d-arm-l"></view>
        <view class="d-limb d-arm-r"></view>
        <view class="d-limb d-leg-l"></view>
        <view class="d-limb d-leg-r"></view>
      </view>
      <!-- 有课但被筛掉了 ≠ 这天没课：说错原因，用户会以为数据漏了 -->
      <view wx:if="{{emptyFiltered}}" class="empty-title">这些筛选下没有课</view>
      <view wx:else class="empty-title">今日暂无课程</view>
      <!-- 开了「只看已约」却空着：原因就是这天没预约，别让人以为课表没数据 -->
      <view wx:if="{{emptyFiltered && onlyBooked}}" class="empty-sub">这天没有已约的课，关掉「只看已约」看全部</view>
      <view wx:elif="{{emptyFiltered}}" class="empty-sub">点上方「全选」恢复，或换一天看看</view>
      <view wx:else class="empty-sub">去「发现」页搜索并关注舞室吧</view>
      <button wx:if="{{!emptyFiltered}}" class="btn-pri empty-btn" hover-class="press" bindtap="goDiscover">去发现</button>
      <!-- 空列表恰恰是最该出现补录入口的时刻：这天没课，多半是这家店没被抓到 -->
      <view class="empty-alt" hover-class="press" bindtap="goImport">＋ 这天有课没抓到？补录一节</view>
    </view>

    <view
      wx:for="{{items}}"
      wx:key="id"
      class="row {{item.isPast ? 'past' : ''}} {{item.bookingStatus === 'CONFIRMED' ? 'booked' : ''}} {{item.bookingStatus === 'PENDING' ? 'pending' : ''}} {{item.bookingStatus ? '' : 'unbooked'}}"
    >
      <view class="time-col">
        <view class="t-start">{{item.startTime}}</view>
        <view class="t-end">{{item.endTime}}</view>
      </view>
      <view class="line">
        <view class="dot {{item.bookingStatus === 'CONFIRMED' ? 'dot-booked' : ''}} {{item.bookingStatus === 'PENDING' ? 'dot-pending' : ''}}"></view>
        <view class="line-body"></view>
      </view>
      <view class="card" hover-class="press">
        <view class="card-head">
          <text class="studio">{{item.studio.name}}</text>
          <text wx:if="{{item.reminded}}" class="remind-flag">🔔</text>
        </view>
        <view class="course-name">
          {{item.courseName}}
          <text class="diff">{{item.diffLabel}}</text>
        </view>
        <view
          class="coach {{item.fav ? 'fav' : ''}}"
          hover-class="press"
          data-name="{{item.coachName}}"
          data-city-id="{{cityId}}"
          bindtap="goCoach"
        >教练：{{item.coachName}}<text wx:if="{{item.fav}}" class="fav-mark">★</text></view>
        <!-- 真实已约人数：来自舞室官方系统（不是本小程序用户数），
             没拿到就按老规矩显示 remark 里的文字状态 -->
        <view
          wx:if="{{item.bookedNum > 0}}"
          class="hot-line"
        >🔥 已有 {{item.bookedNum}} 人约<text wx:if="{{item.capacity}}" class="hot-cap"> / 上限 {{item.capacity}}</text><text wx:if="{{item.bookedAgo}}" class="hot-ago"> · {{item.bookedAgo}}</text></view>
        <view class="card-foot">
          <view wx:if="{{item.slotText}}" class="slot {{item.slotClass}}">{{item.slotText}}</view>
          <view class="btn-row">
            <button wx:if="{{item.bookingStatus === 'CONFIRMED'}}" class="btn booked" disabled>✅ 已约</button>
            <button wx:elif="{{item.bookingStatus === 'PENDING'}}" class="btn pending" data-id="{{item.id}}" bindtap="openPanel">待确认</button>
            <button wx:else class="btn" data-id="{{item.id}}" bindtap="openPanel">预约</button>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view wx:else class="loading-tip">加载中…</view>
</view>

<!-- 预约行动面板 -->
<view wx:if="{{panel.visible}}" class="mask" bindtap="closePanel"></view>
<view wx:if="{{panel.visible}}" class="sheet">
  <view class="sheet-title">
    {{panel.item.studio.name}} — {{panel.item.courseName}}
  </view>
  <view class="sheet-info">
    {{panel.item.scheduleDate}} {{panel.item.startTime}} - {{panel.item.endTime}} · {{panel.item.diffLabel}}
  </view>
  <view class="sheet-info">教练：{{panel.item.coachName}}</view>
  <view wx:if="{{panel.item.bookingStatus === 'PENDING'}}" class="sheet-warn">
    已复制店名，去微信搜索预约后记得回来标记
  </view>
  <view class="sheet-actions">
    <button class="action primary" hover-class="press" bindtap="goBook">复制店名去微信预约</button>
    <button class="action secondary" hover-class="press" bindtap="markBooked">我已约好</button>
    <button class="action remind" hover-class="press" bindtap="toggleRemind">
      {{panel.item.reminded ? '已开启提醒（点击关闭）' : '开启开课提醒'}}
    </button>
    <button wx:if="{{panel.item.bookingStatus}}" class="action danger" hover-class="press" bindtap="cancelBooking">
      取消预约
    </button>
  </view>
</view>

<toast id="toast" />