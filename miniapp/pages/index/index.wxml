<nav-bar title="DanceHub" show-avatar="{{true}}" bind:avatar="goProfile" accent bind:top="onNavTop" />

<view class="body">
  <!-- 地区切换 -->
  <view class="region-row">
    <view class="seg">
      <view class="seg-item {{region === 'CN' ? 'on' : ''}}" hover-class="press" data-r="CN" bindtap="switchRegion">中国</view>
      <view class="seg-item {{region === 'OVERSEAS' ? 'on' : ''}}" hover-class="press" data-r="OVERSEAS" bindtap="switchRegion">海外</view>
    </view>
  </view>

  <!-- 城市快捷选择 -->
  <scroll-view scroll-x class="city-bar" enhanced show-scrollbar="{{false}}">
    <view class="chip chip-locate {{locating ? 'busy' : ''}}" hover-class="press" bindtap="tapLocate">
      {{locating ? '定位中…' : '📍 定位'}}
    </view>
    <view
      wx:for="{{filteredCities}}"
      wx:key="id"
      class="chip {{cityId === item.id ? 'on' : ''}}"
      hover-class="press"
      data-id="{{item.id}}"
      bindtap="selectCity"
    >{{item.name}}</view>
  </scroll-view>

  <!-- 悬浮提醒条 -->
  <view wx:if="{{pendingCount > 0}}" class="reminder-strip" hover-class="press" bindtap="goConfirm">
    📌 您有 {{pendingCount}} 节未确认预约，记得点「我已约好」
  </view>

  <!-- 日期滑条 -->
  <view class="date-nav">
    <view class="arrow" hover-class="press" bindtap="prevDay">‹</view>
    <swiper class="date-swiper" current="{{swiperCurrent}}" duration="200" bindchange="onSwiperChange">
      <swiper-item wx:for="{{dates}}" wx:key="key">
        <view
          class="date-item {{item.isToday ? 'today' : ''}} {{currentKey === item.key ? 'cur' : ''}}"
          hover-class="press"
          data-key="{{item.key}}"
          bindtap="onTapDate"
        >
          <view class="date-day">{{item.isToday ? '今天' : item.day}}</view>
          <view class="date-num">{{item.date}}</view>
        </view>
      </swiper-item>
    </swiper>
    <view class="arrow" hover-class="press" bindtap="nextDay">›</view>
  </view>

  <!-- 已关注门店筛选：多家店同时看时，用它决定时间轴里出现谁 -->
  <view wx:if="{{showStoreBar}}" class="store-filter">
    <scroll-view scroll-x class="store-scroll" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{storeChips}}"
        wx:key="id"
        class="sf-chip {{item.on ? 'on' : ''}}"
        hover-class="press"
        data-id="{{item.id}}"
        bindtap="tapStoreChip"
      >{{item.short}}<text class="sf-n">{{item.count}}</text></view>
    </scroll-view>
    <view class="sf-all" hover-class="press" bindtap="tapAllStores">全选</view>
  </view>

  <!-- 服务不可达：不能只留一片空白，给出原因和重试入口 -->
  <view wx:if="{{loadError}}" class="load-error">
    <view class="le-title">连不上服务</view>
    <view class="le-desc">{{loadError}}</view>
    <view class="le-btn" hover-class="press" bindtap="reload">点击重试</view>
  </view>

  <!-- 时间轴 -->
  <view class="timeline" wx:if="{{!loading}}">
    <view wx:if="{{hiddenCount > 0}}" class="hidden-strip" hover-class="press" bindtap="toggleShowBlocked">
      已隐藏 {{hiddenCount}} 节不想看的课 · 点击展开
    </view>
    <view wx:if="{{showBlocked}}" class="hidden-strip on" hover-class="press" bindtap="toggleShowBlocked">
      正在显示全部课程 · 点击重新隐藏
    </view>
    <view wx:if="{{items.length === 0}}" class="empty">
      <view class="dancer-lg empty-dancer">
        <view class="d-head"></view>
        <view class="d-torso"></view>
        <view class="d-limb d-arm-l"></view>
        <view class="d-limb d-arm-r"></view>
        <view class="d-limb d-leg-l"></view>
        <view class="d-limb d-leg-r"></view>
      </view>
      <view class="empty-title">今日暂无课程</view>
      <view class="empty-sub">去「发现」页搜索并关注舞室吧</view>
      <button class="btn-pri empty-btn" hover-class="press" bindtap="goDiscover">去发现</button>
    </view>

    <view
      wx:for="{{items}}"
      wx:key="id"
      class="row {{item.isPast ? 'past' : ''}} {{item.bookingStatus === 'CONFIRMED' ? 'booked' : ''}}"
    >
      <view class="time-col">
        <view class="t-start">{{item.startTime}}</view>
        <view class="t-end">{{item.endTime}}</view>
      </view>
      <view class="line">
        <view class="dot {{item.bookingStatus ? 'dot-booked' : ''}}"></view>
        <view class="line-body"></view>
      </view>
      <view class="card" hover-class="press">
        <view class="card-head">
          <text class="studio">{{item.studio.name}}</text>
          <text wx:if="{{item.reminded}}" class="remind-flag">🔔</text>
        </view>
        <view class="course-name">
          {{item.courseName}}
          <text class="diff">{{item.diffLabel}}</text>
        </view>
        <view class="coach {{item.fav ? 'fav' : ''}}" hover-class="press" data-name="{{item.coachName}}" bindtap="goCoach">教练：{{item.coachName}}<text wx:if="{{item.fav}}" class="fav-mark">★</text></view>
        <view class="card-foot">
          <view wx:if="{{item.slotText}}" class="slot {{item.slotClass}}">{{item.slotText}}</view>
          <view class="btn-row">
            <button wx:if="{{item.bookingStatus === 'CONFIRMED'}}" class="btn booked" disabled>✅ 已约</button>
            <button wx:elif="{{item.bookingStatus === 'PENDING'}}" class="btn pending" data-id="{{item.id}}" bindtap="openPanel">待确认</button>
            <button wx:else class="btn" data-id="{{item.id}}" bindtap="openPanel">预约</button>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view wx:else class="loading-tip">加载中…</view>
</view>

<!-- 预约行动面板 -->
<view wx:if="{{panel.visible}}" class="mask" bindtap="closePanel"></view>
<view wx:if="{{panel.visible}}" class="sheet">
  <view class="sheet-title">
    {{panel.item.studio.name}} — {{panel.item.courseName}}
  </view>
  <view class="sheet-info">
    {{panel.item.scheduleDate}} {{panel.item.startTime}} - {{panel.item.endTime}} · {{panel.item.diffLabel}}
  </view>
  <view class="sheet-info">教练：{{panel.item.coachName}}</view>
  <view wx:if="{{panel.item.bookingStatus === 'PENDING'}}" class="sheet-warn">
    已复制店名，去微信搜索预约后记得回来标记
  </view>
  <view class="sheet-actions">
    <button class="action primary" hover-class="press" bindtap="goBook">复制店名去微信预约</button>
    <button class="action secondary" hover-class="press" bindtap="markBooked">我已约好</button>
    <button class="action remind" hover-class="press" bindtap="toggleRemind">
      {{panel.item.reminded ? '已开启提醒（点击关闭）' : '开启开课提醒'}}
    </button>
    <button wx:if="{{panel.item.bookingStatus}}" class="action danger" hover-class="press" bindtap="cancelBooking">
      取消预约
    </button>
  </view>
</view>

<toast id="toast" />