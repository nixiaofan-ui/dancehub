page {
  background: #0e0e1c;
}

.body {
  padding: 20rpx 24rpx 60rpx;
}
.intro {
  font-size: 24rpx;
  color: #a8adc2;
  line-height: 1.7;
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-left: 8rpx solid #ff6b35;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  font-weight: 700;
}

.form {
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 8rpx 24rpx 24rpx;
}
.field {
  padding: 20rpx 0 0;
}
.field.half {
  flex: 1;
  min-width: 0;
}
.row2 {
  display: flex;
  gap: 20rpx;
}
.label {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 900;
  margin-bottom: 12rpx;
}
.req {
  color: #ff6b35;
}
.input {
  width: 100%;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-weight: 700;
}
.pick {
  font-size: 26rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-weight: 700;
}
.pick.ph-pick {
  color: #6b7089;
}
.ph {
  color: #6b7089;
  font-weight: 700;
}

.submit {
  margin-top: 32rpx;
  font-size: 30rpx;
  color: #0e0e1c;
  background: linear-gradient(135deg, #ff6b35, #ff8a5c);
  border-radius: 44rpx;
  line-height: 2.4;
  font-weight: 900;
}
.submit.busy {
  opacity: 0.6;
}

.done {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(0, 245, 212, 0.1);
  border: 1rpx solid rgba(0, 245, 212, 0.35);
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #00f5d4;
  line-height: 1.6;
  font-weight: 700;
}
.done-sub {
  color: #a8adc2;
  margin-top: 6rpx;
}

.report-link {
  margin-top: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: #a8adc2;
  text-decoration: underline;
  font-weight: 700;
}

/* 说明里强调的那句「只有你自己看得见」 */
.intro .hl {
  color: #ff6b35;
  font-weight: 900;
}

/* 我录过的课 */
.mine-block {
  margin-top: 40rpx;
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 20rpx 24rpx 8rpx;
}

.mine-title {
  font-size: 26rpx;
  font-weight: 900;
  color: #e8ecf8;
  margin-bottom: 16rpx;
}

.mine-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

.mine-main {
  flex: 1;
  min-width: 0;
}

.mine-course {
  font-size: 26rpx;
  font-weight: 800;
  color: #e8ecf8;
}

.mine-sub {
  font-size: 22rpx;
  color: #a8adc2;
  margin-top: 4rpx;
}

.mine-del {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #e5484d;
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(229, 72, 77, 0.4);
  border-radius: 30rpx;
}
