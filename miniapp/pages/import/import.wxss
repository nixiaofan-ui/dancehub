page {
  background: #0e0e1c;
}

.body {
  padding: 20rpx 24rpx 60rpx;
}
.intro {
  font-size: 24rpx;
  color: #a8adc2;
  line-height: 1.7;
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-left: 8rpx solid #ff6b35;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  font-weight: 700;
}

.form {
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 8rpx 24rpx 24rpx;
}
.field {
  padding: 20rpx 0 0;
}
.field.half {
  flex: 1;
  min-width: 0;
}
.row2 {
  display: flex;
  gap: 20rpx;
}
.label {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 900;
  margin-bottom: 12rpx;
}
.req {
  color: #ff6b35;
}
/* 原生 input 自带 min-height:1.4rem（≈45rpx），只靠上下 padding 撑高会把内容区压到几 rpx，
   文字就被裁掉一半 —— 所以这里必须显式给 height，并且上下不留 padding */
.input {
  width: 100%;
  box-sizing: border-box;
  height: 80rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-weight: 700;
}
.pick {
  box-sizing: border-box;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-weight: 700;
}
.pick.ph-pick {
  color: #6b7089;
}
/* 城市：选择器 + 「库外城市」两个入口并排，后者是给还没接入的城市留的口子 */
.city-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.city-pick {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 手输模式：城市行里直接就是输入框，不再多一个「改用手动输入」的占位块 */
.city-input {
  flex: 1;
  min-width: 0;
}
.city-pick.off {
  color: #6b7089;
}
.city-alt {
  font-size: 24rpx;
  color: #ff6b35;
  font-weight: 700;
  padding: 18rpx 8rpx;
  white-space: nowrap;
}
.hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #79819c;
  line-height: 1.5;
}
.diff-row {
  display: flex;
  gap: 16rpx;
}
.diff-chip {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #a8adc2;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 28rpx;
  padding: 14rpx 0;
  font-weight: 900;
}
.diff-chip.on {
  background: linear-gradient(135deg, #7b2fbe, #9b5cff);
  color: #ffffff;
  border-color: #7b2fbe;
}

/* 行程状态三选一：竖排是因为每个选项都得带一句解释，
   挤成一行小标签的话，用户只会盲点最左边那个 */
.book-col {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.book-opt {
  padding: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
}
.book-opt.on {
  background: rgba(0, 245, 212, 0.12);
  border-color: #00f5d4;
}
.book-head {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 900;
}
.book-check {
  color: #00f5d4;
  margin-left: 8rpx;
}
.book-sub {
  font-size: 22rpx;
  color: #a8adc2;
  margin-top: 4rpx;
  line-height: 1.5;
}

/* 「我录过的课」的状态标签：只看课名分不出这节课到底约没约 */
.mine-tag {
  font-size: 20rpx;
  font-weight: 700;
  padding: 3rpx 12rpx;
  margin-left: 10rpx;
  border-radius: 16rpx;
  vertical-align: middle;
}
.mt-ok {
  background: rgba(0, 245, 212, 0.16);
  color: #00f5d4;
}
.mt-warn {
  background: rgba(255, 107, 53, 0.16);
  color: #ff6b35;
}
.mt-dim {
  background: rgba(255, 255, 255, 0.08);
  color: #a8adc2;
}
.mt-bell {
  background: transparent;
  padding: 0 0 0 6rpx;
  margin-left: 4rpx;
}

.ph {
  color: #6b7089;
  font-weight: 700;
}

.submit {
  margin-top: 32rpx;
  font-size: 30rpx;
  color: #0e0e1c;
  background: linear-gradient(135deg, #ff6b35, #ff8a5c);
  border-radius: 44rpx;
  line-height: 2.4;
  font-weight: 900;
}
.submit.busy {
  opacity: 0.6;
}

.done {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(0, 245, 212, 0.1);
  border: 1rpx solid rgba(0, 245, 212, 0.35);
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #00f5d4;
  line-height: 1.6;
  font-weight: 700;
}
.done-sub {
  color: #a8adc2;
  margin-top: 6rpx;
}

.report-link {
  margin-top: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: #a8adc2;
  text-decoration: underline;
  font-weight: 700;
}

/* 说明里强调的那句「只有你自己看得见」 */
.intro .hl {
  color: #ff6b35;
  font-weight: 900;
}

/* 我录过的课 */
.mine-block {
  margin-top: 40rpx;
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 20rpx 24rpx 8rpx;
}

.mine-title {
  font-size: 26rpx;
  font-weight: 900;
  color: #e8ecf8;
  margin-bottom: 16rpx;
}

.mine-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

.mine-main {
  flex: 1;
  min-width: 0;
}

.mine-course {
  font-size: 26rpx;
  font-weight: 800;
  color: #e8ecf8;
}

.mine-sub {
  font-size: 22rpx;
  color: #a8adc2;
  margin-top: 4rpx;
}

.mine-del {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #e5484d;
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(229, 72, 77, 0.4);
  border-radius: 30rpx;
}
