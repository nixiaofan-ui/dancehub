<nav-bar title="课表录入" show-back="{{true}}" bind:top="onNavTop" />

<view class="body">
  <view class="intro">
    抓不到的独立舞室可以自己录。<text class="hl">录的课只有你自己看得见</text>，
    不用怕填错影响别人 —— 但课表页上它会出现在你选的城市和日期里，
    所以日期和时间还是照真实课表填。
  </view>

  <view class="form">
    <!-- 城市放在最前：录哪家店之前先定它是哪座城的店。
         默认当前城市，库里没有的城市可以手输，服务端顺手建出来 -->
    <view class="field">
      <view class="label">城市 <text class="req">*</text></view>
      <view class="city-row">
        <!-- 手输模式下这一行本身就是输入框，不再另外叠一个 input，
             免得上方留着「改用手动输入」的占位、下面又冒出一个空框 -->
        <input
          wx:if="{{customCityMode}}"
          class="input city-input"
          placeholder="输入城市名，例如：三亚"
          placeholder-class="ph"
          value="{{customCityName}}"
          bindinput="onCustomCity"
        />
        <view
          wx:else
          class="city-pick {{cityName ? '' : 'off'}}"
          hover-class="press"
          bindtap="openCityPicker"
        >{{cityName || '选择城市'}}</view>
        <view class="city-alt" hover-class="press" bindtap="tapCustomCity">
          {{customCityMode ? '取消' : '+ 库外城市'}}
        </view>
      </view>
      <view wx:if="{{customCityMode}}" class="hint">
        这个城市我们还没接入 —— 录入后会建出来，之后在「我的 · 我的城市」里能找到
      </view>
    </view>

    <view class="field">
      <view class="label">门店名称 <text class="req">*</text></view>
      <input
        class="input"
        placeholder="库里没有的店会顺手建出来"
        placeholder-class="ph"
        value="{{studioName}}"
        bindinput="onStudio"
      />
    </view>

    <view class="field">
      <view class="label">日期</view>
      <picker mode="date" value="{{dateText}}" start="{{dateStart}}" end="{{dateEnd}}" bindchange="onDate">
        <view class="pick">{{dateText}}</view>
      </picker>
    </view>

    <view class="row2">
      <view class="field half">
        <view class="label">开始 <text class="req">*</text></view>
        <picker mode="time" value="{{startText}}" bindchange="onStart">
          <view class="pick">{{startText}}</view>
        </picker>
      </view>
      <view class="field half">
        <view class="label">结束</view>
        <picker mode="time" value="{{endText || endAuto}}" bindchange="onEnd">
          <view class="pick {{endText ? '' : 'ph-pick'}}">{{endText ? endText : '默认 ' + endAuto}}</view>
        </picker>
      </view>
    </view>

    <view class="field">
      <view class="label">课程名称 <text class="req">*</text></view>
      <input
        class="input"
        placeholder="例如：Jazz 基础"
        placeholder-class="ph"
        value="{{courseName}}"
        bindinput="onCourse"
      />
    </view>

    <view class="field">
      <view class="label">教练</view>
      <input
        class="input"
        placeholder="可留空"
        placeholder-class="ph"
        value="{{coachName}}"
        bindinput="onCoach"
      />
    </view>

    <view class="field">
      <view class="label">难度</view>
      <!-- 四个选项就没必要开滚轮了，直接点反而更快 -->
      <view class="diff-row">
        <view
          wx:for="{{diffs}}"
          wx:key="*this"
          class="diff-chip {{diffIndex === index ? 'on' : ''}}"
          hover-class="press"
          data-i="{{index}}"
          bindtap="tapDiff"
        >{{item}}</view>
      </view>
    </view>
    <!-- 补录不是往库里丢一条数据，而是把一节课加进我的行程。
         所以必须问一句这节课怎么处理 —— 以前不问，用户录完还得回课表再点一次
         「预约」，于是「我录过的课」在预约记录里永远查不到 -->
    <view class="field">
      <view class="label">这节课怎么处理</view>
      <view class="book-col">
        <view
          wx:for="{{bookOpts}}"
          wx:key="title"
          class="book-opt {{bookMode === item.value ? 'on' : ''}}"
          hover-class="press"
          data-value="{{item.value}}"
          bindtap="tapBook"
        >
          <view class="book-head">
            {{item.title}}
            <text wx:if="{{bookMode === item.value}}" class="book-check">✓</text>
          </view>
          <view class="book-sub">{{item.sub}}</view>
        </view>
      </view>
    </view>
  </view>

  <button class="submit {{submitBusy ? 'busy' : ''}}" hover-class="press" bindtap="submit">
    {{submitBusy ? '录入中…' : '录入这一节'}}
  </button>

  <view wx:if="{{lastResult}}" class="done">
    ✅ {{lastResult.bookText}}：{{lastResult.city}} · {{lastResult.studio}} · {{lastResult.date}} {{lastResult.time}} · {{lastResult.course}}
    <view class="done-sub">继续录下一节吧</view>
  </view>

  <!-- 我录过的课：能录就得能删，填错日期的人不该被一条错课永久纠缠 -->
  <view class="mine-block" wx:if="{{mine.length}}">
    <view class="mine-title">我录过的课（{{mine.length}}）</view>
    <view class="mine-item" wx:for="{{mine}}" wx:key="id">
      <view class="mine-main">
        <view class="mine-course">
          {{item.courseName}}
          <text wx:if="{{item.bookingStatus === 'CONFIRMED'}}" class="mine-tag mt-ok">已约</text>
          <text wx:elif="{{item.bookingStatus === 'PENDING'}}" class="mine-tag mt-warn">想上</text>
          <text wx:else class="mine-tag mt-dim">只记录</text>
          <text wx:if="{{item.hasReminder}}" class="mine-tag mt-bell">🔔</text>
        </view>
        <view class="mine-sub">
          <block wx:if="{{item.cityName}}">{{item.cityName}} · </block>{{item.studioName}} · {{item.date}} {{item.startTime}}-{{item.endTime}}<block wx:if="{{item.coachName}}"> · {{item.coachName}}</block>
        </view>
      </view>
      <view class="mine-del" hover-class="press" data-id="{{item.id}}" bindtap="delMine">删除</view>
    </view>
  </view>

  <view class="report-link" hover-class="press" bindtap="goReport">
    不确定这家店叫什么？去提报
  </view>
</view>

<city-picker
  visible="{{cityPickerVisible}}"
  cities="{{filteredCities}}"
  cityId="{{cityId}}"
  region="{{region}}"
  locating="{{locating}}"
  allow-custom="{{true}}"
  bind:close="closeCityPicker"
  bind:select="onPickCity"
  bind:locate="onPickLocate"
  bind:custom="onPickCustomCity"
/>

<toast id="toast" />
