<nav-bar title="教练" show-back="{{true}}" bind:top="onNavTop" />

<view class="body">
  <view wx:if="{{loading}}" class="tip">正在整理这位老师的课…</view>

  <block wx:else>
    <view class="coach-head">
      <view class="ch-top">
        <view class="ch-name">{{name}}</view>
        <!-- 常看的老师（爱师）：与页尾的「不想看」是一对反向偏好 -->
        <button class="fav-btn {{fav ? 'on' : ''}}" hover-class="press" bindtap="toggleFav">
          {{fav ? '★ 常看中' : '☆ 设为常看'}}
        </button>
      </view>
      <view class="ch-meta" wx:if="{{studios.length}}">
        过去一周在 {{studios.length}} 家舞室上过 {{pastTotal}} 节课
      </view>
      <view class="ch-meta" wx:else>过去一周没有抓到这位老师的排课</view>
    </view>

    <!-- 任教门店：这老师在哪跑，是这张页最值钱的一句话 -->
    <scroll-view wx:if="{{studios.length}}" scroll-x class="st-bar" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{studios}}"
        wx:key="id"
        class="st-item"
        hover-class="press"
        data-id="{{item.id}}"
        bindtap="goStudio"
      >
        <view class="st-short">{{item.short}}</view>
        <view class="st-count">{{item.count}} 节</view>
      </view>
    </scroll-view>

    <!--
      主视图：过去一周的排课规律。
      舞蹈工作室普遍只放最近几天的课，「未来两周」常年是 0，
      所以这里用「上周周几 · 几点 · 哪家店 · 什么课」来描述这位老师。
    -->
    <view class="section-title">上周排课规律</view>
    <view wx:if="{{weekdays.length === 0}}" class="tip">过去一周没有这位老师的课</view>
    <view wx:for="{{weekdays}}" wx:key="weekday" class="day-block">
      <view class="day-label">{{item.weekday}} · {{item.count}} 节</view>
      <view
        wx:for="{{item.items}}"
        wx:for-item="s"
        wx:key="id"
        class="card {{s.diffClass}}"
        hover-class="press"
        data-id="{{s.id}}"
        bindtap="goCourse"
      >
        <view class="c-time">{{s.timeLabel}}</view>
        <view class="c-main">
          <view class="c-name-row">
            <view class="c-name">{{s.courseName}}</view>
          </view>
          <view class="c-meta">
            <text class="c-store">{{s.studioShort}}</text>
            <text class="c-diff">{{s.diffLabel}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 次视图：真的有未来课表时才占地方，否则一句话带过 -->
    <view class="section-title">接下来能约</view>
    <view wx:if="{{days.length === 0}}" class="tip">
      这位老师还没放出未来的课，按上面的规律去蹲就行
    </view>
    <view wx:for="{{days}}" wx:key="key" class="day-block">
      <view class="day-label">{{item.label}} · {{item.items.length}} 节</view>
      <view
        wx:for="{{item.items}}"
        wx:for-item="s"
        wx:key="id"
        class="card {{s.diffClass}} {{s.booked ? 'booked' : ''}}"
        hover-class="press"
        data-id="{{s.id}}"
        bindtap="goCourse"
      >
        <view class="c-time">{{s.timeLabel}}</view>
        <view class="c-main">
          <view class="c-name-row">
            <view class="c-name">{{s.courseName}}</view>
            <view wx:if="{{s.booked}}" class="c-booked">✅ 已约</view>
          </view>
          <view class="c-meta">
            <text class="c-store">{{s.studioShort}}</text>
            <text class="c-diff">{{s.diffLabel}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="block-row">
      <view class="block-hint">
        {{blocked ? '已在课表里隐藏这位老师的课' : '上过不喜欢的课？可以不再显示这位老师'}}
      </view>
      <button class="block-btn {{blocked ? 'off' : ''}}" hover-class="press" bindtap="toggleBlock">
        {{blocked ? '恢复显示' : '不想看他的课'}}
      </button>
    </view>
  </block>
</view>

<toast id="toast" />
