.body {
  padding: 20rpx 24rpx 60rpx;
}
.tip {
  text-align: center;
  color: #a8adc2;
  padding: 80rpx 0;
  font-size: 28rpx;
  font-weight: 700;
}

.coach-head {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  border: 2rpx solid #2b3050;
  border-left: 10rpx solid #b18cff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
}
.ch-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ch-name {
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}
/* 常看的老师（爱师）：未标记时是描边态，标记后填充成高亮色 */
.fav-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 24rpx;
  font-size: 24rpx;
  line-height: 2;
  font-weight: 900;
  color: #b18cff;
  background: transparent;
  border: 2rpx solid rgba(177, 140, 255, 0.5);
  border-radius: 40rpx;
}
.fav-btn.on {
  color: #1a1a2e;
  background: #b18cff;
  border-color: #b18cff;
}
.ch-meta {
  font-size: 24rpx;
  color: #a8adc2;
  margin-top: 8rpx;
  font-weight: 700;
}

/* 任教门店横滑 */
.st-bar {
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.st-item {
  display: inline-block;
  width: 180rpx;
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  margin-right: 14rpx;
  vertical-align: top;
}
.st-short {
  font-size: 24rpx;
  font-weight: 900;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.st-count {
  font-size: 22rpx;
  color: #b18cff;
  margin-top: 6rpx;
  font-weight: 700;
}
/* 今天就有课：这条是「现在能不能去上」的答案，值得用主色点出来 */
.st-count.hot {
  color: #00f5d4;
}

/* 接口失败：说清原因 + 就地重试（空白页会被读成「这老师没课」） */
.load-error {
  text-align: center;
  padding: 80rpx 40rpx;
}
.le-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #ffffff;
}
.le-desc {
  font-size: 24rpx;
  color: #a8adc2;
  margin-top: 14rpx;
  font-weight: 700;
  line-height: 1.6;
}
.le-btn {
  display: inline-block;
  margin-top: 32rpx;
  font-size: 26rpx;
  font-weight: 900;
  color: #00f5d4;
  border: 1rpx solid rgba(0, 245, 212, 0.5);
  border-radius: 40rpx;
  padding: 12rpx 44rpx;
}

.day-block {
  margin-bottom: 28rpx;
}
.day-label {
  font-size: 26rpx;
  font-weight: 900;
  color: #ffffff;
  padding: 0 0 14rpx 4rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  margin-bottom: 14rpx;
}

.card {
  display: flex;
  align-items: center;
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
}
.card.booked {
  border-color: rgba(0, 245, 212, 0.4);
}
.c-time {
  flex-shrink: 0;
  width: 150rpx;
  font-size: 26rpx;
  font-weight: 900;
  color: #00f5d4;
}
.c-main {
  flex: 1;
  min-width: 0;
}
.c-name-row {
  display: flex;
  align-items: center;
}
.c-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 900;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.c-booked {
  font-size: 20rpx;
  color: #0e0e1c;
  background: #00f5d4;
  border-radius: 20rpx;
  padding: 3rpx 12rpx;
  margin-left: 10rpx;
  font-weight: 900;
}
.c-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}
.c-store {
  font-size: 22rpx;
  color: #ff9f6b;
  font-weight: 700;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.c-diff {
  font-size: 20rpx;
  color: #a8adc2;
  margin-left: 16rpx;
  font-weight: 700;
}

.block-row {
  margin-top: 40rpx;
  padding: 24rpx;
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
}
.block-hint {
  font-size: 24rpx;
  color: #a8adc2;
  text-align: center;
  font-weight: 700;
}
.block-btn {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #ff6b35;
  background: transparent;
  border: 2rpx solid rgba(255, 107, 53, 0.5);
  border-radius: 40rpx;
  line-height: 1.8;
  font-weight: 900;
}
.block-btn.off {
  color: #00f5d4;
  border-color: rgba(0, 245, 212, 0.5);
}

/* 分区标题：把「上周规律」和「未来可约」两块分开 */
.section-title {
  margin: 28rpx 0 12rpx;
  font-size: 26rpx;
  font-weight: 900;
  color: #00f5d4;
  letter-spacing: 2rpx;
}
.section-title::before {
  content: "";
  display: inline-block;
  width: 8rpx;
  height: 24rpx;
  background: #ff6b35;
  border-radius: 4rpx;
  margin-right: 12rpx;
  vertical-align: -2rpx;
}
