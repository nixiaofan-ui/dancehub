<nav-bar title="发现" bind:top="onNavTop" />

<view class="body">
  <view class="region-row">
    <view class="seg">
      <view class="seg-item {{region === 'CN' ? 'on' : ''}}" hover-class="press" data-r="CN" bindtap="switchRegion">中国</view>
      <view class="seg-item {{region === 'OVERSEAS' ? 'on' : ''}}" hover-class="press" data-r="OVERSEAS" bindtap="switchRegion">海外</view>
    </view>
  </view>

  <!--
    城市切换：100 来个城市塞进一条横滑条，找一个三线城要滑半天，
    所以只常驻 8 个热门 + 一个「全部」入口，剩下的进城市面板（搜索/字母/定位）。
    当前选中的城市即便不是热门也会被顶到第一位（pickHot 保证），
    否则用户切完之后在 chip 条上看不到自己选的是谁。
  -->
  <scroll-view scroll-x class="city-bar" enhanced show-scrollbar="{{false}}">
    <!-- 定位单独放一个 chip：原来要点开城市面板才能定位，找城市平白多一步 -->
    <view class="chip chip-locate" hover-class="press" bindtap="tapLocate">
      {{locating ? '定位中…' : '📍 定位'}}
    </view>
    <view
      wx:for="{{hotCities}}"
      wx:key="id"
      class="chip {{cityId === item.id ? 'on' : ''}}"
      hover-class="press"
      data-id="{{item.id}}"
      bindtap="selectCity"
    >{{item.name}}</view>
    <view class="chip chip-all" hover-class="press" bindtap="openCityPicker">
      {{cityName || '全部城市'}} · 全部<text class="ca-caret">⌄</text>
    </view>
  </scroll-view>

  <city-picker
    visible="{{cityPickerVisible}}"
    cities="{{filteredCities}}"
    cityId="{{cityId}}"
    region="{{region}}"
    locating="{{locating}}"
    bind:close="closeCityPicker"
    bind:select="onPickCity"
    bind:locate="onPickLocate"
  />

  <view class="search-box">
    <view class="search-ico">
      <view class="mag-circle"></view>
      <view class="mag-bar"></view>
    </view>
    <input
      class="search-input"
      placeholder="搜索舞室名称 / 地址"
      placeholder-class="search-ph"
      confirm-type="search"
      value="{{keyword}}"
      bindinput="onSearch"
      bindconfirm="onSearchConfirm"
    />
    <view wx:if="{{keyword}}" class="clear" hover-class="press" bindtap="clearKeyword">✕</view>
    <view class="search-btn" hover-class="press" bindtap="onSearchConfirm">搜索</view>
  </view>

  <!--
    全国搜索的命中城市条：默认全国搜，命中哪几个城市在这里列出来，
    点一下才收窄。这样「不知道那家舞室在哪个城市」也能直接搜。
  -->
  <view wx:if="{{cityCounts.length}}" class="hit-bar">
    <view
      class="hb-chip hb-all {{!searchCityId ? 'on' : ''}}"
      hover-class="press"
      bindtap="clearSearchCity"
    >全国 {{hitTotal}}</view>
    <scroll-view scroll-x class="hb-scroll" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{cityCounts}}"
        wx:key="cityId"
        class="hb-chip {{searchCityId === item.cityId ? 'on' : ''}}"
        hover-class="press"
        data-id="{{item.cityId}}"
        bindtap="tapHitCity"
      >{{item.name}} {{item.count}}</view>
    </scroll-view>
  </view>

  <!--
    自选组合：品牌条只能对比「同一个品牌的分店」，而真实需求常常是
    「我公司附近这三家、不管是不是一个牌子」，所以单独给一个自由挑选的入口。
  -->
  <view class="pick-entry" hover-class="press" bindtap="goPick">
    <view class="pe-main">
      <view class="pe-title">自选组合</view>
      <view class="pe-sub">不限品牌，挑任意几家门店同屏对比</view>
    </view>
    <view class="pe-arrow">›</view>
  </view>

  <!-- 多店品牌：同城开了好几家分店的品牌，点进去一次看完全部门店的课 -->
  <view wx:if="{{brands.length}}" class="brand-block">
    <view class="brand-head">
      <view class="brand-title">连锁 / 多店品牌</view>
      <view class="brand-sub">一次看完全部分店</view>
    </view>
    <scroll-view scroll-x class="brand-bar" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{brands}}"
        wx:key="name"
        class="brand-card"
        hover-class="press"
        data-index="{{index}}"
        bindtap="goBrand"
      >
        <view class="bc-name">{{item.name}}</view>
        <view class="bc-count">{{item.storeCount}} 家分店</view>
        <view class="bc-branch">{{item.stores[0].branch}} 等</view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{loading && sections.length === 0}}" class="loading">
    <view class="dancer-lg">
      <view class="d-head"></view>
      <view class="d-torso"></view>
      <view class="d-limb d-arm-l"></view>
      <view class="d-limb d-arm-r"></view>
      <view class="d-limb d-leg-l"></view>
      <view class="d-limb d-leg-r"></view>
    </view>
    <view class="loading-text">正在热身…</view>
  </view>

  <!--
    行政区筛选：同城店多了以后，「只看海淀区的」是最常见的收窄方式。
    ⚠ 覆盖率不是 100%（上游地址长期缺失），抽不到区的店单独成「未标注」一档并默认带上，
    数字摆在 chip 上 —— 悄悄剔掉会让用户以为筛出来的是全部。
  -->
  <view wx:if="{{showDistrictBar}}" class="dist-filter">
    <scroll-view scroll-x class="dist-scroll" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{districtChips}}"
        wx:key="label"
        class="df-chip {{item.on ? 'on' : ''}}"
        hover-class="press"
        data-label="{{item.label}}"
        bindtap="tapDistrictChip"
      >{{item.label}}<text class="df-n">{{item.count}}</text></view>
    </scroll-view>
    <view class="df-all" hover-class="press" bindtap="tapAllDistricts">全选</view>
  </view>

  <!--
    同城搜不到、但全国有命中。
    没有这一句的话，「杭州搜 T-rex」看到的就是一片空 —— 用户只会以为我们没收录，
    而实际上是那家店挂在别的城市（t-rex dance 在北京）。点一下放开城市限定。
  -->
  <view wx:if="{{crossCity}}" class="cross-bar" hover-class="press" bindtap="goCrossCity">
    <view class="cb-main">
      <view class="cb-title">本城没有「{{keyword}}」</view>
      <view class="cb-sub">全国还有 {{crossCity.total}} 家 · {{crossCityText}}，看看 ›</view>
    </view>
  </view>

  <view wx:if="{{!loading && sections.length === 0}}" class="empty">
    <view class="dancer-lg empty-dancer">
      <view class="d-head"></view>
      <view class="d-torso"></view>
      <view class="d-limb d-arm-l"></view>
      <view class="d-limb d-arm-r"></view>
      <view class="d-limb d-leg-l"></view>
      <view class="d-limb d-leg-r"></view>
    </view>
    <view class="empty-title">搜了个寂寞</view>
    <view class="empty-sub">换个关键词，试试手气</view>
    <button class="empty-report" hover-class="press" bindtap="goReport">没找到我要的舞室？告诉我们</button>
  </view>

  <!-- 常驻提报入口：搜得到不代表搜得全，缺谁让用户直接告诉我们 -->
  <view class="report-row" hover-class="press" bindtap="goReport">
    <view class="rr-text">没找到你想去的舞室？<text class="rr-em">告诉我们</text></view>
    <view class="rr-arrow">›</view>
  </view>

  <view class="studio-list">
    <block wx:for="{{sections}}" wx:key="letter" wx:for-item="sec">
      <!--
        锚点必须放在这层「不吸顶」的包裹元素上，不能放 sec-head：
        sec-head 是 sticky，吸住后它的位置恒等于状态栏下沿，
        用它算滚动距离会导致「往回跳不动」。
      -->
      <view class="sec-block" id="sec-{{sec.letter === '#' ? 'SHARP' : sec.letter}}">
        <view
          class="sec-head"
          style="top: {{statusBarHeight}}px"
        >
          <text class="sec-letter">{{sec.letter}}</text>
          <text class="sec-count">{{sec.studios.length}}</text>
        </view>

        <view
          wx:for="{{sec.studios}}"
          wx:key="id"
          wx:for-item="item"
          class="studio-card"
          hover-class="press"
          data-id="{{item.id}}"
          bindtap="goWeekly"
        >
          <view class="avatar">{{item.avatarText}}</view>
          <view class="info">
            <!-- 店名分两级：主名实、分店名虚，长名各自截断而不是撑破卡片 -->
            <view class="name-row">
              <text class="name">{{item.brand}}</text>
              <text wx:if="{{item.branch}}" class="branch">{{item.branch}}</text>
              <!-- 跨城结果才带城市标签：同城列表里每家都挂个城市名纯属噪音 -->
              <text wx:if="{{globalMode && item.cityName}}" class="city-tag">{{item.cityName}}</text>
            </view>
            <!-- 品牌行第二行列分店；单店行显示地址。两者共用省略号样式 -->
            <view wx:if="{{item.branchLine}}" class="addr-line">{{item.branchLine}}</view>
            <view wx:elif="{{item.address}}" class="addr-line">{{item.address}}</view>
            <view wx:if="{{item.styles.length}}" class="tag-row">
              <view
                wx:for="{{item.styles}}"
                wx:for-item="st"
                wx:key="*this"
                class="style-tag"
              >{{st}}</view>
              <view wx:if="{{item.extraStyles}}" class="style-tag more">+{{item.extraStyles}}</view>
            </view>
          </view>
          <!-- 品牌行本身没有可关注的对象 → 箭头单点进「分店列表」，在那里逐店关注 -->
          <button
            wx:if="{{!item.isBrand}}"
            class="follow {{item.followed ? 'followed' : ''}}"
            hover-class="press"
            data-id="{{item.id}}"
            catchtap="toggleFollow"
          >{{item.followed ? '已关注' : '关注'}}</button>
          <view
            wx:else
            class="chev"
            hover-class="press"
            data-id="{{item.id}}"
            catchtap="goBranches"
          >›</view>
        </view>
      </view>
    </block>
  </view>
</view>

<!-- 右侧字母索引条：按住滑动可快速定位到对应首字母分组 -->
<view
  wx:if="{{letters.length >= 2}}"
  class="index-bar"
  catchtouchstart="onIndexStart"
  catchtouchmove="onIndexMove"
  catchtouchend="onIndexEnd"
  catchtouchcancel="onIndexEnd"
>
  <view
    wx:for="{{letters}}"
    wx:key="*this"
    class="index-item {{activeLetter === item ? 'on' : ''}}"
  >{{item}}</view>
</view>

<view wx:if="{{indexTip}}" class="index-tip">{{activeLetter}}</view>

<toast id="toast" />