<nav-bar title="发现" bind:top="onNavTop" />

<view class="body">
  <view class="region-row">
    <view class="seg">
      <view class="seg-item {{region === 'CN' ? 'on' : ''}}" hover-class="press" data-r="CN" bindtap="switchRegion">中国</view>
      <view class="seg-item {{region === 'OVERSEAS' ? 'on' : ''}}" hover-class="press" data-r="OVERSEAS" bindtap="switchRegion">海外</view>
    </view>
  </view>

  <scroll-view scroll-x class="city-bar" enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{filteredCities}}"
      wx:key="id"
      class="chip {{cityId === item.id ? 'on' : ''}}"
      hover-class="press"
      data-id="{{item.id}}"
      bindtap="selectCity"
    >{{item.name}}</view>
  </scroll-view>

  <view class="search-box">
    <view class="search-ico">
      <view class="mag-circle"></view>
      <view class="mag-bar"></view>
    </view>
    <input
      class="search-input"
      placeholder="搜索舞室名称 / 地址"
      placeholder-class="search-ph"
      confirm-type="search"
      value="{{keyword}}"
      bindinput="onSearch"
      bindconfirm="onSearchConfirm"
    />
    <view wx:if="{{keyword}}" class="clear" hover-class="press" bindtap="clearKeyword">✕</view>
    <view class="search-btn" hover-class="press" bindtap="onSearchConfirm">搜索</view>
  </view>

  <!-- 多店品牌：同城开了好几家分店的品牌，点进去一次看完全部门店的课 -->
  <view wx:if="{{brands.length}}" class="brand-block">
    <view class="brand-head">
      <view class="brand-title">连锁 / 多店品牌</view>
      <view class="brand-sub">一次看完全部分店</view>
    </view>
    <scroll-view scroll-x class="brand-bar" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{brands}}"
        wx:key="name"
        class="brand-card"
        hover-class="press"
        data-index="{{index}}"
        bindtap="goBrand"
      >
        <view class="bc-name">{{item.name}}</view>
        <view class="bc-count">{{item.storeCount}} 家分店</view>
        <view class="bc-branch">{{item.stores[0].branch}} 等</view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{loading && sections.length === 0}}" class="loading">
    <view class="dancer-lg">
      <view class="d-head"></view>
      <view class="d-torso"></view>
      <view class="d-limb d-arm-l"></view>
      <view class="d-limb d-arm-r"></view>
      <view class="d-limb d-leg-l"></view>
      <view class="d-limb d-leg-r"></view>
    </view>
    <view class="loading-text">正在热身…</view>
  </view>

  <view wx:if="{{!loading && sections.length === 0}}" class="empty">
    <view class="dancer-lg empty-dancer">
      <view class="d-head"></view>
      <view class="d-torso"></view>
      <view class="d-limb d-arm-l"></view>
      <view class="d-limb d-arm-r"></view>
      <view class="d-limb d-leg-l"></view>
      <view class="d-limb d-leg-r"></view>
    </view>
    <view class="empty-title">搜了个寂寞</view>
    <view class="empty-sub">换个关键词，试试手气</view>
    <button class="empty-report" hover-class="press" bindtap="goReport">没找到我要的舞室？告诉我们</button>
  </view>

  <!-- 常驻提报入口：搜得到不代表搜得全，缺谁让用户直接告诉我们 -->
  <view class="report-row" hover-class="press" bindtap="goReport">
    <view class="rr-text">没找到你想去的舞室？<text class="rr-em">告诉我们</text></view>
    <view class="rr-arrow">›</view>
  </view>

  <view class="studio-list">
    <block wx:for="{{sections}}" wx:key="letter" wx:for-item="sec">
      <!--
        锚点必须放在这层「不吸顶」的包裹元素上，不能放 sec-head：
        sec-head 是 sticky，吸住后它的位置恒等于状态栏下沿，
        用它算滚动距离会导致「往回跳不动」。
      -->
      <view class="sec-block" id="sec-{{sec.letter === '#' ? 'SHARP' : sec.letter}}">
        <view
          class="sec-head"
          style="top: {{statusBarHeight}}px"
        >
          <text class="sec-letter">{{sec.letter}}</text>
          <text class="sec-count">{{sec.studios.length}}</text>
        </view>

        <view
          wx:for="{{sec.studios}}"
          wx:key="id"
          wx:for-item="item"
          class="studio-card"
          hover-class="press"
          data-id="{{item.id}}"
          bindtap="goWeekly"
        >
          <view class="avatar">{{item.avatarText}}</view>
          <view class="info">
            <!-- 店名分两级：主名实、分店名虚，长名各自截断而不是撑破卡片 -->
            <view class="name-row">
              <text class="name">{{item.brand}}</text>
              <text wx:if="{{item.branch}}" class="branch">{{item.branch}}</text>
            </view>
            <view wx:if="{{item.address}}" class="addr-line">{{item.address}}</view>
            <view wx:if="{{item.styles.length}}" class="tag-row">
              <view
                wx:for="{{item.styles}}"
                wx:for-item="st"
                wx:key="*this"
                class="style-tag"
              >{{st}}</view>
              <view wx:if="{{item.extraStyles}}" class="style-tag more">+{{item.extraStyles}}</view>
            </view>
          </view>
          <button
            class="follow {{item.followed ? 'followed' : ''}}"
            hover-class="press"
            data-id="{{item.id}}"
            catchtap="toggleFollow"
          >{{item.followed ? '已关注' : '关注'}}</button>
        </view>
      </view>
    </block>
  </view>
</view>

<!-- 右侧字母索引条：按住滑动可快速定位到对应首字母分组 -->
<view
  wx:if="{{letters.length >= 2}}"
  class="index-bar"
  catchtouchstart="onIndexStart"
  catchtouchmove="onIndexMove"
  catchtouchend="onIndexEnd"
  catchtouchcancel="onIndexEnd"
>
  <view
    wx:for="{{letters}}"
    wx:key="*this"
    class="index-item {{activeLetter === item ? 'on' : ''}}"
  >{{item}}</view>
</view>

<view wx:if="{{indexTip}}" class="index-tip">{{activeLetter}}</view>

<toast id="toast" />