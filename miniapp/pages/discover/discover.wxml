<nav-bar title="发现" />

<view class="body">
  <view class="region-row">
    <view class="seg">
      <view class="seg-item {{region === 'CN' ? 'on' : ''}}" hover-class="press" data-r="CN" bindtap="switchRegion">中国</view>
      <view class="seg-item {{region === 'OVERSEAS' ? 'on' : ''}}" hover-class="press" data-r="OVERSEAS" bindtap="switchRegion">海外</view>
    </view>
  </view>

  <scroll-view scroll-x class="city-bar" enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{cities}}"
      wx:key="id"
      class="chip {{cityId === item.id ? 'on' : ''}}"
      hover-class="press"
      data-id="{{item.id}}"
      bindtap="selectCity"
    >{{item.name}}</view>
  </scroll-view>

  <view class="search-box">
    <view class="search-ico">
      <view class="mag-circle"></view>
      <view class="mag-bar"></view>
    </view>
    <input
      class="search-input"
      placeholder="搜索舞室名称 / 地址"
      placeholder-class="search-ph"
      confirm-type="search"
      value="{{keyword}}"
      bindinput="onSearch"
      bindconfirm="onSearchConfirm"
    />
    <view wx:if="{{keyword}}" class="clear" hover-class="press" bindtap="clearKeyword">✕</view>
    <view class="search-btn" hover-class="press" bindtap="onSearchConfirm">搜索</view>
  </view>

  <view wx:if="{{!loading && studios.length === 0}}" class="empty">
    <view class="jam-graphic">
      <view class="jam-a"></view>
      <view class="jam-b"></view>
      <view class="jam-c"></view>
    </view>
    <view class="empty-title">搜了个寂寞</view>
    <view class="empty-sub">换个关键词，试试手气</view>
  </view>

  <view class="studio-list">
    <view
      wx:for="{{studios}}"
      wx:key="id"
      class="studio-card"
      hover-class="press"
      data-id="{{item.id}}"
      bindtap="goWeekly"
    >
      <view class="avatar">{{item.initial}}</view>
      <view class="info">
        <view class="name">{{item.name}}</view>
        <view class="meta">{{item.city ? item.city.name : ''}} · {{item.platformLabel}}</view>
        <view wx:if="{{item.address}}" class="meta addr">{{item.address}}</view>
      </view>
      <view class="card-arrow">›</view>
      <button
        class="follow {{item.followed ? 'followed' : ''}}"
        hover-class="press"
        data-id="{{item.id}}"
        catchtap="toggleFollow"
      >{{item.followed ? '已关注' : '关注'}}</button>
    </view>
  </view>
</view>

<toast id="toast" />