.body {
  padding: 20rpx 24rpx 220rpx;
}

.region-row {
  display: flex;
  justify-content: center;
  margin-bottom: 18rpx;
}
.seg {
  display: flex;
  background: rgba(26, 26, 46, 0.7);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 40rpx;
  padding: 6rpx;
}
.seg-item {
  padding: 10rpx 48rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #aaaaaa;
  font-weight: 700;
}
.seg-item.on {
  background: linear-gradient(135deg, #ff6b35, #ff8a5c);
  color: #ffffff;
  font-weight: 900;
}

.city-bar {
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.chip {
  display: inline-block;
  padding: 10rpx 32rpx;
  margin-right: 16rpx;
  background: #16213e;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #aaaaaa;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  font-weight: 700;
}
.chip.on {
  background: linear-gradient(135deg, #7b2fbe, #9b5cff);
  color: #ffffff;
  border-color: #7b2fbe;
  font-weight: 900;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 48rpx;
  padding: 12rpx 12rpx 12rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.3);
}
.search-ico {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.mag-circle {
  position: absolute;
  left: 2rpx;
  top: 2rpx;
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid #00f5d4;
  border-radius: 50%;
}
.mag-bar {
  position: absolute;
  right: 0;
  bottom: 4rpx;
  width: 4rpx;
  height: 14rpx;
  background: #00f5d4;
  border-radius: 4rpx;
  transform: rotate(45deg);
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #ffffff;
}
.search-ph {
  color: #6f7590;
}
.clear {
  padding: 0 16rpx;
  color: #aaaaaa;
  font-weight: 900;
}
.search-btn {
  background: linear-gradient(135deg, #ff6b35, #ff8a5c);
  color: #ffffff;
  border-radius: 40rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  font-weight: 900;
}

/* 缺失舞室提报 */
.empty-report {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #00f5d4;
  background: transparent;
  border: 2rpx solid rgba(0, 245, 212, 0.45);
  border-radius: 40rpx;
  padding: 12rpx 32rpx;
  font-weight: 900;
}
.report-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  background: #16213e;
  border: 1rpx dashed rgba(255, 255, 255, 0.16);
  border-radius: 14rpx;
}
.rr-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #a8adc2;
  font-weight: 700;
}
.rr-em {
  color: #00f5d4;
}
.rr-arrow {
  flex-shrink: 0;
  font-size: 32rpx;
  color: #00f5d4;
  margin-left: 12rpx;
}

/* 多店品牌横滑区 */
.brand-block {
  margin-bottom: 20rpx;
}
.brand-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 14rpx;
}
.brand-title {
  font-size: 28rpx;
  font-weight: 900;
  color: #ffffff;
}
.brand-sub {
  font-size: 22rpx;
  color: #a8adc2;
  margin-left: 14rpx;
  font-weight: 700;
}
.brand-bar {
  white-space: nowrap;
}
.brand-card {
  display: inline-block;
  width: 240rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  border: 2rpx solid #2b3050;
  border-left: 8rpx solid #00f5d4;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-right: 16rpx;
  vertical-align: top;
}
.bc-name {
  font-size: 26rpx;
  font-weight: 900;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bc-count {
  font-size: 22rpx;
  color: #00f5d4;
  margin-top: 8rpx;
  font-weight: 700;
}
.bc-branch {
  font-size: 20rpx;
  color: #a8adc2;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 700;
}

/*
 * 舞室卡片
 *
 * 视觉层次：左侧紫色竖条定位 → 头像 → 店名（主名实/分店名虚）
 *          → 地址（淡）→ 舞种标签（最轻）。
 * 只有店名是白色高字重，其余逐级降级，避免整张卡片都在「喊」。
 */
.studio-card {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
  /* 右侧给字母索引条让位（索引条固定宽约 44rpx，right: 2rpx） */
  margin-right: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-left: 5rpx solid rgba(123, 47, 190, 0.9);
  border-radius: 20rpx;
  /* 比纯色 #16213e 多一层明暗，卡片才从页面底色上浮起来 */
  background: linear-gradient(160deg, #1c2547 0%, #151c35 100%);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.25);
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #7b2fbe, #9b5cff);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.22);
}

.info {
  flex: 1;
  /*
   * ⚠ min-width: 0 不能删。
   * flex item 默认 min-width: auto，下限是内容的 min-content 宽度，
   * 长店名（如 MAX POWER STUDIO（苏河湾店））会把 .info 撑得比剩余空间还宽，
   * 右侧「关注」按钮就被顶出卡片外——这正是之前截图里只剩半个「关」字的原因。
   * 归零之后下面的 ellipsis 才真正生效。
   */
  min-width: 0;
  margin: 0 18rpx;
}

/* 店名两级：主名 30rpx/800 白，分店名 21rpx/600 灰蓝 */
.name-row {
  display: flex;
  align-items: baseline;
  min-width: 0;
}
.name {
  font-size: 30rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 0.5rpx;
  min-width: 0;
  flex-shrink: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.branch {
  font-size: 21rpx;
  font-weight: 600;
  color: #8f97b4;
  margin-left: 10rpx;
  flex-shrink: 0;
}

.addr-line {
  font-size: 22rpx;
  font-weight: 500;
  color: #767e99;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/*
 * 舞种标签（由后端从课名自动解析）
 *
 * 原来每个标签都是 900 字重 + 霓虹青描边，四个排开像一排警示灯，
 * 比店名还抢眼。改成「淡底、无边框、正常字重」，
 * 让它退回辅助信息的层级；青色只留在文字上。
 */
.tag-row {
  display: flex;
  /* 不换行：标签超出时由 .info 的 overflow 裁掉，卡片高度才整齐
     （换行会让带长地址的卡片比邻居高一截，列表看起来是歪的） */
  flex-wrap: nowrap;
  overflow: hidden;
  margin-top: 12rpx;
}
.style-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  color: #5eead4;
  background: rgba(0, 245, 212, 0.1);
  border-radius: 6rpx;
  padding: 3rpx 12rpx;
  line-height: 1.5;
  margin-right: 8rpx;
}
/* 超出 MAX_TAGS 的收成一个中性色的 +N，不跟舞种抢青色 */
.style-tag.more {
  color: #79819c;
  background: rgba(255, 255, 255, 0.06);
}

/* 加载中：舞者剪影（样式定义在 app.wxss 的 .dancer-lg） */
.loading {
  padding: 120rpx 40rpx;
  text-align: center;
}
.loading-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #6f7590;
  letter-spacing: 2rpx;
}
/*
 * 关注按钮
 *
 * ⚠ 小程序 button 自带 margin: auto 和一层 ::after 边框，
 * 不重置的话胶囊外面会多出一个圆角方框（描边款尤其明显），必须显式关掉。
 * 尺寸也收了一圈：右侧还有字母索引条，按钮过大就会挤到内容上。
 */
.follow {
  flex-shrink: 0;
  width: auto;
  margin: 0;
  font-size: 23rpx;
  font-weight: 700;
  color: #00f5d4;
  background: rgba(0, 245, 212, 0.1);
  border: 1rpx solid rgba(0, 245, 212, 0.4);
  border-radius: 28rpx;
  padding: 6rpx 22rpx;
  line-height: 1.7;
}
.follow::after {
  border: none;
}
/* 已关注态走中性色：原来未关注/已关注是两个极端（描边 vs 实心高亮），
   一屏里全是亮块，反而分不清哪个是待操作 */
.follow.followed {
  color: #79819c;
  background: transparent;
  border-color: rgba(255, 255, 255, 0.14);
}

/* ───────────────── 首字母分组 ───────────────── */

/* 分组标题吸顶：top 由页面按状态栏高度动态设置，否则会被刘海遮住 */
.sec-head {
  position: sticky;
  z-index: 5;
  display: flex;
  align-items: center;
  height: 52rpx;
  margin-bottom: 10rpx;
  padding-left: 6rpx;
  /* 与页面底色一致，吸顶时才不会透出下面的卡片 */
  background: #1a1a2e;
  font-size: 26rpx;
  font-weight: 900;
  color: #00f5d4;
  letter-spacing: 2rpx;
}
.sec-letter {
  min-width: 34rpx;
}
.sec-count {
  margin-left: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #6f7590;
  letter-spacing: 0;
}

/* ───────────────── 右侧字母索引条 ───────────────── */

/*
 * 注意：不要给索引条加垂直 padding / margin。
 * 它的高度必须精确等于「字母数 × 单格高度」，
 * 页面里是用 height / letters.length 把触点坐标换算成字母的。
 */
.index-bar {
  position: fixed;
  right: 2rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 4rpx;
  background: rgba(22, 33, 62, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.35);
}
.index-item {
  width: 34rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 900;
  color: #8b90a8;
}
.index-item.on {
  color: #00f5d4;
  transform: scale(1.3);
}

/* 滑动时屏幕中央弹出的字母气泡 */
.index-tip {
  position: fixed;
  left: 50%;
  top: 50%;
  width: 150rpx;
  height: 150rpx;
  margin: -75rpx 0 0 -75rpx;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: rgba(0, 245, 212, 0.94);
  color: #0e0e1c;
  font-size: 72rpx;
  font-weight: 900;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.5);
}