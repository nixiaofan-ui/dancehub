.body {
  padding: 20rpx 24rpx 220rpx;
}

.region-row {
  display: flex;
  justify-content: center;
  margin-bottom: 18rpx;
}
.seg {
  display: flex;
  background: rgba(26, 26, 46, 0.7);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 40rpx;
  padding: 6rpx;
}
.seg-item {
  padding: 10rpx 48rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #aaaaaa;
  font-weight: 700;
}
.seg-item.on {
  background: linear-gradient(135deg, #ff6b35, #ff8a5c);
  color: #ffffff;
  font-weight: 900;
}

.city-bar {
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.chip {
  display: inline-block;
  padding: 10rpx 32rpx;
  margin-right: 16rpx;
  background: #16213e;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #aaaaaa;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  font-weight: 700;
}
.chip.on {
  background: linear-gradient(135deg, #7b2fbe, #9b5cff);
  color: #ffffff;
  border-color: #7b2fbe;
  font-weight: 900;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 48rpx;
  padding: 12rpx 12rpx 12rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.3);
}
.search-ico {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.mag-circle {
  position: absolute;
  left: 2rpx;
  top: 2rpx;
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid #00f5d4;
  border-radius: 50%;
}
.mag-bar {
  position: absolute;
  right: 0;
  bottom: 4rpx;
  width: 4rpx;
  height: 14rpx;
  background: #00f5d4;
  border-radius: 4rpx;
  transform: rotate(45deg);
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #ffffff;
}
.search-ph {
  color: #6f7590;
}
.clear {
  padding: 0 16rpx;
  color: #aaaaaa;
  font-weight: 900;
}
.search-btn {
  background: linear-gradient(135deg, #ff6b35, #ff8a5c);
  color: #ffffff;
  border-radius: 40rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  font-weight: 900;
}

/* 舞室卡片 */
.studio-card {
  display: flex;
  align-items: center;
  background: #16213e;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  /* 右侧给字母索引条让位，避免压住卡片上的「关注」按钮 */
  margin-right: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.3);
}
.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #7b2fbe, #9b5cff);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.info {
  flex: 1;
  margin: 0 16rpx;
}
.name {
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}
.addr-line {
  font-size: 24rpx;
  color: #aaaaaa;
  margin-top: 6rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 舞种标签（由后端从课名自动解析） */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}
.style-tag {
  font-size: 22rpx;
  font-weight: 900;
  color: #00f5d4;
  background: rgba(0, 245, 212, 0.12);
  border: 1rpx solid rgba(0, 245, 212, 0.35);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  line-height: 1.6;
  margin: 0 8rpx 6rpx 0;
}

/* 加载中：舞者剪影（样式定义在 app.wxss 的 .dancer-lg） */
.loading {
  padding: 120rpx 40rpx;
  text-align: center;
}
.loading-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #6f7590;
  letter-spacing: 2rpx;
}
/* 关注按钮：默认霓虹青描边，关注后填充霓虹青 */
.follow {
  font-size: 26rpx;
  color: #00f5d4;
  background: transparent;
  border: 2rpx solid #00f5d4;
  border-radius: 32rpx;
  padding: 8rpx 28rpx;
  line-height: 1.8;
  font-weight: 900;
  flex-shrink: 0;
}
.follow.followed {
  color: #0e0e1c;
  background: #00f5d4;
  border-color: #00f5d4;
}

.card-arrow {
  width: 40rpx;
  margin-right: 12rpx;
  color: #ff6b35;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
  flex-shrink: 0;
}

/* ───────────────── 首字母分组 ───────────────── */

/* 分组标题吸顶：top 由页面按状态栏高度动态设置，否则会被刘海遮住 */
.sec-head {
  position: sticky;
  z-index: 5;
  display: flex;
  align-items: center;
  height: 52rpx;
  margin-bottom: 10rpx;
  padding-left: 6rpx;
  /* 与页面底色一致，吸顶时才不会透出下面的卡片 */
  background: #1a1a2e;
  font-size: 26rpx;
  font-weight: 900;
  color: #00f5d4;
  letter-spacing: 2rpx;
}
.sec-letter {
  min-width: 34rpx;
}
.sec-count {
  margin-left: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #6f7590;
  letter-spacing: 0;
}

/* ───────────────── 右侧字母索引条 ───────────────── */

/*
 * 注意：不要给索引条加垂直 padding / margin。
 * 它的高度必须精确等于「字母数 × 单格高度」，
 * 页面里是用 height / letters.length 把触点坐标换算成字母的。
 */
.index-bar {
  position: fixed;
  right: 2rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 4rpx;
  background: rgba(22, 33, 62, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.35);
}
.index-item {
  width: 34rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 900;
  color: #8b90a8;
}
.index-item.on {
  color: #00f5d4;
  transform: scale(1.3);
}

/* 滑动时屏幕中央弹出的字母气泡 */
.index-tip {
  position: fixed;
  left: 50%;
  top: 50%;
  width: 150rpx;
  height: 150rpx;
  margin: -75rpx 0 0 -75rpx;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: rgba(0, 245, 212, 0.94);
  color: #0e0e1c;
  font-size: 72rpx;
  font-weight: 900;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.5);
}