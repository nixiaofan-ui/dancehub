.body {
  padding: 20rpx 24rpx 220rpx;
}

.region-row {
  display: flex;
  justify-content: center;
  margin-bottom: 18rpx;
}
.seg {
  display: flex;
  background: #1a1a2e;
  border: 2rpx solid #ff6b35;
  border-radius: 40rpx;
  padding: 6rpx;
}
.seg-item {
  padding: 10rpx 48rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #a8adc2;
  font-weight: 700;
}
.seg-item.on {
  background: #ff6b35;
  color: #0e0e1c;
  font-weight: 900;
}

.city-bar {
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.chip {
  display: inline-block;
  padding: 10rpx 32rpx;
  margin-right: 16rpx;
  background: #16213e;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #a8adc2;
  border: 2rpx solid #2b3050;
  font-weight: 700;
}
.chip.on {
  background: #7b2fbe;
  color: #ffffff;
  border-color: #7b2fbe;
  font-weight: 900;
}

.search-box {
  display: flex;
  align-items: center;
  background: #1a1a2e;
  border: 2rpx solid #ff6b35;
  border-radius: 40rpx;
  padding: 10rpx 12rpx 10rpx 28rpx;
  margin-bottom: 20rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #ffffff;
}
.search-input::placeholder {
  color: #6f7590;
}
.clear {
  padding: 0 16rpx;
  color: #a8adc2;
  font-weight: 900;
}
.search-btn {
  background: #ff6b35;
  color: #0e0e1c;
  border-radius: 32rpx;
  padding: 10rpx 28rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.studio-card {
  display: flex;
  align-items: center;
  background: #16213e;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #7b2fbe;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.info {
  flex: 1;
  margin: 0 16rpx;
}
.name {
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}
.meta {
  font-size: 24rpx;
  color: #a8adc2;
  margin-top: 4rpx;
  font-weight: 700;
}
.addr {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.follow {
  font-size: 26rpx;
  color: #0e0e1c;
  background: #ff6b35;
  border-radius: 32rpx;
  padding: 8rpx 28rpx;
  line-height: 1.8;
  font-weight: 900;
  flex-shrink: 0;
}
.follow.followed {
  color: #00f5d4;
  background: #1a1a2e;
  border: 2rpx solid #00f5d4;
}

/* 卡片右箭头（可进周视图） */
.card-arrow {
  width: 40rpx;
  margin-right: 12rpx;
  color: #ff6b35;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
  flex-shrink: 0;
}