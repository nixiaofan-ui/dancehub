.body {
  padding: 20rpx 24rpx 220rpx;
}

/* 「关于与隐私」入口：备案号必须有小程序内可达路径 */
.about-entry {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 22rpx 28rpx;
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
}
.about-ico {
  font-size: 28rpx;
  color: #00f5d4;
  margin-right: 16rpx;
}
.about-txt {
  flex: 1;
  font-size: 25rpx;
  font-weight: 700;
  color: #c8ccdd;
}
.about-arrow {
  font-size: 32rpx;
  color: #6b7089;
}

/* 我的城市：录过课的城市，横排 chip，数字是录了几节 */
.mycity-block {
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
}
.mycity-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #c8ccdd;
  margin-bottom: 18rpx;
}
.mycity-sub {
  margin-left: 12rpx;
  font-size: 21rpx;
  font-weight: 500;
  color: #6b7089;
}
.mycity-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.mycity-chip {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
  background: rgba(123, 47, 190, 0.18);
  border: 1rpx solid rgba(123, 47, 190, 0.5);
  border-radius: 999rpx;
}
.mycity-n {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: #00f5d4;
}

.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  border: 2rpx solid #2b3050;
  border-left: 10rpx solid #7b2fbe;
  border-radius: 16rpx;
  padding: 28rpx;
  color: #ffffff;
}
.user-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #ff6b35;
  border: 3rpx solid #00f5d4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
  color: #0e0e1c;
  flex-shrink: 0;
}
.user-meta {
  flex: 1;
  margin: 0 20rpx;
}
.user-name {
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}
.user-sub {
  font-size: 24rpx;
  opacity: 0.7;
  margin-top: 6rpx;
  font-weight: 700;
}
.seg {
  display: flex;
  background: #0e0e1c;
  border-radius: 36rpx;
  padding: 4rpx;
  flex-shrink: 0;
}
.seg-item {
  padding: 8rpx 26rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #a8adc2;
}
.seg-item.on {
  background: #00f5d4;
  color: #0e0e1c;
  font-weight: 900;
}

.tabs {
  background: #1a1a2e;
  border-radius: 16rpx;
  margin: 20rpx 0;
  padding: 8rpx;
}
.tabs-inner {
  display: flex;
}
.tab {
  flex-shrink: 0;
  white-space: nowrap;
  text-align: center;
  padding: 16rpx 22rpx;
  font-size: 28rpx;
  color: #a8adc2;
  border-radius: 12rpx;
  font-weight: 700;
}
.tab.on {
  background: #ff6b35;
  color: #0e0e1c;
  font-weight: 900;
}
/* tab 上的数量小标 */
.tab-n {
  display: inline-block;
  min-width: 32rpx;
  font-size: 18rpx;
  color: #0e0e1c;
  background: #00f5d4;
  border-radius: 16rpx;
  padding: 0 8rpx;
  margin-left: 6rpx;
  line-height: 1.6;
  font-weight: 900;
}

/* 关注 */
.follow-card {
  display: flex;
  align-items: center;
  background: #16213e;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.follow-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: #7b2fbe;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.follow-info {
  flex: 1;
  margin: 0 16rpx;
}
.follow-name {
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}
.follow-meta {
  font-size: 24rpx;
  color: #a8adc2;
  margin-top: 4rpx;
  font-weight: 700;
}
.unfollow {
  font-size: 26rpx;
  color: #ff6b35;
  background: rgba(255, 107, 53, 0.12);
  border-radius: 32rpx;
  padding: 8rpx 28rpx;
  line-height: 1.8;
  font-weight: 900;
  flex-shrink: 0;
}

/* 记录 */
.record-card {
  background: #16213e;
  border-left: 8rpx solid #2b3050;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.record-head {
  display: flex;
  align-items: center;
}
.record-course {
  font-size: 30rpx;
  font-weight: 900;
  flex: 1;
  letter-spacing: 1rpx;
}
.status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  font-weight: 900;
}
.status.ok {
  color: #00f5d4;
  background: rgba(0, 245, 212, 0.15);
}
.status.pending {
  color: #ff6b35;
  background: rgba(255, 107, 53, 0.15);
}
.record-meta {
  font-size: 24rpx;
  color: #a8adc2;
  margin-top: 6rpx;
  font-weight: 700;
}
.remind-time {
  font-size: 24rpx;
  color: #00f5d4;
  margin-top: 8rpx;
  font-weight: 700;
}
.close-remind {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #a8adc2;
  background: #1a1a2e;
  border: 2rpx solid #2b3050;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  display: inline-block;
  line-height: 1.6;
  font-weight: 700;
}
/* 老师的两种偏好：常看 / 不看 合在同一张卡片上
   —— 名字右边的小标签是「当前状态」，下面两个按钮是「改状态」，点亮的那个即当前值 */
.card-dim {
  border-left-color: #3a3f63;
}
.coach-tag {
  font-size: 20rpx;
  font-weight: 900;
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
  margin-left: 10rpx;
  flex-shrink: 0;
}
.tag-fav {
  color: #0e0e1c;
  background: #ffd166;
}
.tag-block {
  color: #ffffff;
  background: #6b7089;
}
.coach-acts {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}
.coach-act {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #a8adc2;
  background: #1a1a2e;
  border: 2rpx solid #2b3050;
  border-radius: 12rpx;
  padding: 12rpx 0;
  font-weight: 700;
}
.coach-act.act-fav {
  color: #0e0e1c;
  background: #ffd166;
  border-color: #ffd166;
}
.coach-act.act-block {
  color: #ffffff;
  background: #ff6b6b;
  border-color: rgba(255, 107, 107, 0.6);
}
/* 取消预约：同上，但用红色强调是破坏性操作 */
.cancel-book {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #ff6b6b;
  background: #1a1a2e;
  border: 2rpx solid rgba(255, 107, 107, 0.45);
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  display: inline-block;
  line-height: 1.6;
  font-weight: 700;
}

/* ── 我的课表 ──
   一行里要同时说清三件事：这课哪来的（我录的 / 抓取的）、现在什么状态
   （已约 / 待确认 / 只记录）、还能做什么操作。 */

/* 状态比原来预约记录的 ok/pending 多出一档「只记录」（录了但没约），
   所以单独开一组 class，不去复写 .status */
.sk {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 900;
  flex-shrink: 0;
}
.sk-ok {
  color: #00f5d4;
  background: rgba(0, 245, 212, 0.15);
}
.sk-warn {
  color: #ff6b35;
  background: rgba(255, 107, 53, 0.15);
}
.sk-dim {
  color: #a8adc2;
  background: rgba(255, 255, 255, 0.08);
}

/* 来源标签：不标出来的话，用户删不掉「我录的」也看不出哪些是大家都能约的 */
.chip-src {
  display: inline-block;
  font-size: 20rpx;
  color: #a8adc2;
  background: rgba(255, 255, 255, 0.07);
  border-radius: 16rpx;
  padding: 2rpx 12rpx;
  margin-right: 10rpx;
  font-weight: 700;
}
.chip-src.src-mine {
  color: #ffd166;
  background: rgba(255, 209, 102, 0.14);
}

.row-acts {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
}
.act {
  font-size: 24rpx;
  color: #a8adc2;
  background: #1a1a2e;
  border: 2rpx solid #2b3050;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  line-height: 1.6;
  font-weight: 700;
}
.act-book {
  color: #0e0e1c;
  background: #00f5d4;
  border-color: #00f5d4;
}
.act-cancel {
  color: #ff6b6b;
  border-color: rgba(255, 107, 107, 0.45);
}
.act-del {
  color: #ff6b6b;
  border-color: rgba(255, 107, 107, 0.45);
  margin-left: auto;
}
.act-past {
  font-size: 20rpx;
  color: #6b7089;
  font-weight: 700;
}