<nav-bar title="我的" bind:top="onNavTop" />

<view class="body">
  <view class="user-card">
    <view class="user-avatar">我</view>
    <view class="user-meta">
      <view class="user-name">DanceHub 舞者</view>
      <view class="user-sub">关注 · 预约 · 提醒 一站管理</view>
    </view>
  </view>

  <view class="about-entry" hover-class="press" bindtap="goAbout">
    <text class="about-ico">ⓘ</text>
    <text class="about-txt">关于与隐私 · 备案信息</text>
    <text class="about-arrow">›</text>
  </view>

  <!-- 课表录入：抓不到的店由用户补。页面早就做好了，缺的就是这个入口 -->
  <view class="about-entry" hover-class="press" bindtap="goImport">
    <text class="about-ico">✎</text>
    <text class="about-txt">补录课表 · 没抓到的店你来填</text>
    <text class="about-arrow">›</text>
  </view>

  <!-- 标签横向滚动：五个标签等分会把字挤到一起 -->
  <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
    <view class="tabs-inner">
      <view class="tab {{tab === 'follows' ? 'on' : ''}}" data-tab="follows" bindtap="switchTab">关注</view>
      <view class="tab {{tab === 'favs' ? 'on' : ''}}" data-tab="favs" bindtap="switchTab">
        常看的老师<text wx:if="{{favs.length}}" class="tab-n">{{favs.length}}</text>
      </view>
      <view class="tab {{tab === 'bookings' ? 'on' : ''}}" data-tab="bookings" bindtap="switchTab">预约记录</view>
      <view class="tab {{tab === 'reminders' ? 'on' : ''}}" data-tab="reminders" bindtap="switchTab">提醒设置</view>
      <view class="tab {{tab === 'blocked' ? 'on' : ''}}" data-tab="blocked" bindtap="switchTab">
        不看的老师<text wx:if="{{blocked.length}}" class="tab-n">{{blocked.length}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 常看的老师（爱师）：课表里会优先看到他们的课 -->
  <view wx:if="{{tab === 'favs'}}">
    <view wx:if="{{favs.length === 0}}" class="empty">
      <view class="dancer-lg empty-dancer">
        <view class="d-head"></view>
        <view class="d-torso"></view>
        <view class="d-limb d-arm-l"></view>
        <view class="d-limb d-arm-r"></view>
        <view class="d-limb d-leg-l"></view>
        <view class="d-limb d-leg-r"></view>
      </view>
      <view class="empty-title">还没有常看的老师</view>
      <view class="empty-sub">在课表里点教练名，把本命老师标成常看</view>
    </view>
    <view wx:for="{{favs}}" wx:key="*this" class="record-card">
      <view class="record-head" hover-class="press" data-name="{{item}}" bindtap="goCoach">
        <text class="record-course">★ {{item}}</text>
      </view>
      <view class="record-meta">课表里会优先看到这位老师</view>
      <button class="close-remind" data-name="{{item}}" bindtap="unfavCoach">取消常看</button>
    </view>
  </view>

  <!-- 不想看的老师：屏蔽必须能撤销，否则就是单向黑名单 -->
  <view wx:if="{{tab === 'blocked'}}">
    <view wx:if="{{blocked.length === 0}}" class="empty">
      <view class="dancer-lg empty-dancer">
        <view class="d-head"></view>
        <view class="d-torso"></view>
        <view class="d-limb d-arm-l"></view>
        <view class="d-limb d-arm-r"></view>
        <view class="d-limb d-leg-l"></view>
        <view class="d-limb d-leg-r"></view>
      </view>
      <view class="empty-title">没有屏蔽任何老师</view>
      <view class="empty-sub">在课表里点教练名，可以把他藏起来</view>
    </view>
    <view wx:for="{{blocked}}" wx:key="*this" class="record-card">
      <view class="record-head">
        <text class="record-course">{{item}}</text>
      </view>
      <view class="record-meta">课表里已隐藏这位老师的课</view>
      <button class="close-remind" data-name="{{item}}" bindtap="unblockCoach">恢复显示</button>
    </view>
  </view>

  <!-- 关注 -->
  <view wx:if="{{tab === 'follows'}}">
    <view wx:if="{{follows.length === 0}}" class="empty">
      <view class="dancer-lg empty-dancer">
        <view class="d-head"></view>
        <view class="d-torso"></view>
        <view class="d-limb d-arm-l"></view>
        <view class="d-limb d-arm-r"></view>
        <view class="d-limb d-leg-l"></view>
        <view class="d-limb d-leg-r"></view>
      </view>
      <view class="empty-title">还没关注任何舞室</view>
      <view class="empty-sub">去「发现」Pick 你的本命舞室</view>
    </view>
    <view wx:for="{{follows}}" wx:key="id" class="follow-card">
      <view class="follow-avatar">{{item.initial}}</view>
      <view class="follow-info">
        <view class="follow-name">{{item.studio.name}}</view>
        <view class="follow-meta">{{item.studio.city}} · {{item.platformLabel}}</view>
      </view>
      <button class="unfollow" data-id="{{item.studio.id}}" bindtap="unfollow">取消</button>
    </view>
  </view>

  <!-- 预约记录 -->
  <view wx:if="{{tab === 'bookings'}}">
    <view wx:if="{{bookings.length === 0}}" class="empty">
      <view class="dancer-lg empty-dancer">
        <view class="d-head"></view>
        <view class="d-torso"></view>
        <view class="d-limb d-arm-l"></view>
        <view class="d-limb d-arm-r"></view>
        <view class="d-limb d-leg-l"></view>
        <view class="d-limb d-leg-r"></view>
      </view>
      <view class="empty-title">一张票都还没约</view>
      <view class="empty-sub">首页点「预约」，抢位不等人</view>
    </view>
    <view wx:for="{{bookings}}" wx:key="id" class="record-card">
      <view class="record-head">
        <text class="record-course">{{item.schedule.courseName}}</text>
        <text class="status {{item.status === 'CONFIRMED' ? 'ok' : 'pending'}}">{{item.statusLabel}}</text>
      </view>
      <view class="record-meta">{{item.cityName}} · {{item.schedule.studio}}</view>
      <view class="record-meta">{{item.dateLabel}} {{item.schedule.startTime}} - {{item.schedule.endTime}} · {{item.schedule.coach || '教练待定'}}</view>
      <button class="cancel-book" hover-class="press" data-id="{{item.schedule.id}}" data-name="{{item.schedule.courseName}}" bindtap="cancelBooking">取消预约</button>
    </view>
  </view>

  <!-- 提醒设置 -->
  <view wx:if="{{tab === 'reminders'}}">
    <view wx:if="{{reminders.length === 0}}" class="empty">
      <view class="dancer-lg empty-dancer">
        <view class="d-head"></view>
        <view class="d-torso"></view>
        <view class="d-limb d-arm-l"></view>
        <view class="d-limb d-arm-r"></view>
        <view class="d-limb d-leg-l"></view>
        <view class="d-limb d-leg-r"></view>
      </view>
      <view class="empty-title">一个提醒都没设</view>
      <view class="empty-sub">看好课就开提醒，别迟到</view>
    </view>
    <view wx:for="{{reminders}}" wx:key="id" class="record-card">
      <view class="record-head">
        <text class="record-course">🔔 {{item.schedule.courseName}}</text>
      </view>
      <view class="record-meta">{{item.cityName}} · {{item.schedule.studio}}</view>
      <view class="record-meta">{{item.dateLabel}} {{item.schedule.startTime}}</view>
      <view class="remind-time">开课前 2 小时提醒（{{item.status}}）</view>
      <button class="close-remind" data-id="{{item.schedule.id}}" bindtap="closeReminder">关闭提醒</button>
    </view>
  </view>
</view>

<toast id="toast" />
