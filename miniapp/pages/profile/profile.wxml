<nav-bar title="我的" bind:top="onNavTop" />

<view class="body">
  <view class="user-card">
    <view class="user-avatar">我</view>
    <view class="user-meta">
      <view class="user-name">DanceHub 舞者</view>
      <view class="user-sub">关注 · 预约 · 提醒 一站管理</view>
    </view>
  </view>

  <view class="about-entry" hover-class="press" bindtap="goAbout">
    <text class="about-ico">ⓘ</text>
    <text class="about-txt">关于与隐私 · 备案信息</text>
    <text class="about-arrow">›</text>
  </view>

  <!-- 课表录入：抓不到的店由用户补。页面早就做好了，缺的就是这个入口 -->
  <view class="about-entry" hover-class="press" bindtap="goImport">
    <text class="about-ico">✎</text>
    <text class="about-txt">补录课表 · 没抓到的店你来填</text>
    <text class="about-arrow">›</text>
  </view>

  <!-- 我的城市：录入课去过的城市，含库里原本没有、录入时新建的（比如三亚）。
       这些城市在切换城市里未必有入口，这里给它们一个固定的落脚点 -->
  <view class="mycity-block" wx:if="{{myCities.length}}">
    <view class="mycity-title">
      我的城市
      <text class="mycity-sub">我录过课的地方</text>
    </view>
    <view class="mycity-row">
      <view
        wx:for="{{myCities}}"
        wx:key="id"
        class="mycity-chip"
        hover-class="press"
        data-id="{{item.id}}"
        data-region="{{item.region}}"
        data-name="{{item.name}}"
        bindtap="goMyCity"
      >{{item.name}}<text class="mycity-n">{{item.count}}</text></view>
    </view>
  </view>

  <!-- 标签横向滚动：五个标签等分会把字挤到一起 -->
  <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
    <view class="tabs-inner">
      <view class="tab {{tab === 'follows' ? 'on' : ''}}" data-tab="follows" bindtap="switchTab">关注</view>
      <view class="tab {{tab === 'coaches' ? 'on' : ''}}" data-tab="coaches" bindtap="switchTab">
        我的老师<text wx:if="{{coaches.length}}" class="tab-n">{{coaches.length}}</text>
      </view>
      <view class="tab {{tab === 'mine' ? 'on' : ''}}" data-tab="mine" bindtap="switchTab">我的课表<text wx:if="{{schedules.length}}" class="tab-n">{{schedules.length}}</text></view>
      <view class="tab {{tab === 'reminders' ? 'on' : ''}}" data-tab="reminders" bindtap="switchTab">提醒设置</view>
    </view>
  </scroll-view>

  <!-- 老师的两种偏好合在一处：本质是同一件事的两端（往前排 / 收起来），
       拆成两个 tab 反而互相看不见，改个偏好还得先想清楚要去哪一栏。
       两个开关互斥：同时开着等于没设，所以开一个会自动解另一个 -->
  <view wx:if="{{tab === 'coaches'}}">
    <view wx:if="{{coaches.length === 0}}" class="empty">
      <view class="dancer-lg empty-dancer">
        <view class="d-head"></view>
        <view class="d-torso"></view>
        <view class="d-limb d-arm-l"></view>
        <view class="d-limb d-arm-r"></view>
        <view class="d-limb d-leg-l"></view>
        <view class="d-limb d-leg-r"></view>
      </view>
      <view class="empty-title">还没标记过老师</view>
      <view class="empty-sub">在课表里点教练名，可以设成常看或屏蔽</view>
    </view>
    <view wx:for="{{coaches}}" wx:key="name" class="record-card {{item.blocked ? 'card-dim' : ''}}">
      <view class="record-head" hover-class="press" data-name="{{item.name}}" bindtap="goCoach">
        <text class="record-course">{{item.fav ? '★ ' : ''}}{{item.name}}</text>
        <text wx:if="{{item.fav}}" class="coach-tag tag-fav">常看</text>
        <text wx:if="{{item.blocked}}" class="coach-tag tag-block">不看</text>
      </view>
      <view class="record-meta">
        {{item.blocked ? '课表里已隐藏这位老师的课' : '课表里会优先看到这位老师'}}
      </view>
      <view class="coach-acts">
        <view
          class="coach-act {{item.fav ? 'act-fav' : ''}}"
          hover-class="press"
          data-name="{{item.name}}"
          bindtap="toggleCoachFav"
        >★ 常看</view>
        <view
          class="coach-act {{item.blocked ? 'act-block' : ''}}"
          hover-class="press"
          data-name="{{item.name}}"
          bindtap="toggleCoachBlock"
        >✕ 不看</view>
      </view>
    </view>
  </view>

  <!-- 关注 -->
  <view wx:if="{{tab === 'follows'}}">
    <view wx:if="{{follows.length === 0}}" class="empty">
      <view class="dancer-lg empty-dancer">
        <view class="d-head"></view>
        <view class="d-torso"></view>
        <view class="d-limb d-arm-l"></view>
        <view class="d-limb d-arm-r"></view>
        <view class="d-limb d-leg-l"></view>
        <view class="d-limb d-leg-r"></view>
      </view>
      <view class="empty-title">还没关注任何舞室</view>
      <view class="empty-sub">去「发现」Pick 你的本命舞室</view>
    </view>
    <view
      wx:for="{{follows}}"
      wx:key="id"
      class="follow-card"
      hover-class="press"
      data-id="{{item.studio.id}}"
      bindtap="openStudio"
    >
      <view class="follow-avatar">{{item.initial}}</view>
      <view class="follow-info">
        <view class="follow-name">{{item.studio.name}}</view>
        <view class="follow-meta">{{item.studio.city}} · {{item.platformLabel}}</view>
      </view>
      <!-- catchtap：卡片本身可点进门店，取消按钮必须吃掉冒泡，否则点取消会连带跳走 -->
      <button class="unfollow" data-id="{{item.studio.id}}" catchtap="unfollow">取消</button>
    </view>
  </view>

  <!-- 我的课表：我录的课 + 我约的课，合并一处。
       以前这两拨数据分列两处（预约记录里没有录的课，录课页里没有约的课），
       两边都不完整，于是「录完就消失」成了常态 -->
  <view wx:if="{{tab === 'mine'}}">
    <view wx:if="{{schedules.length === 0}}" class="empty">
      <view class="dancer-lg empty-dancer">
        <view class="d-head"></view>
        <view class="d-torso"></view>
        <view class="d-limb d-arm-l"></view>
        <view class="d-limb d-arm-r"></view>
        <view class="d-limb d-leg-l"></view>
        <view class="d-limb d-leg-r"></view>
      </view>
      <view class="empty-title">这里还空着</view>
      <view class="empty-sub">在课表里约一节课，或补录一节抓不到的课，都会出现在这里</view>
    </view>
    <view wx:for="{{schedules}}" wx:key="id" class="record-card {{item.past ? 'card-dim' : ''}}">
      <view class="record-head">
        <text class="record-course">{{item.courseName}}</text>
        <text class="sk {{item.statusClass}}">{{item.statusLabel}}</text>
      </view>
      <view class="record-meta">
        <text class="chip-src {{item.mine ? 'src-mine' : ''}}">{{item.sourceLabel}}</text>
        {{item.cityName}} · {{item.studioName}}
      </view>
      <view class="record-meta">
        {{item.dateText}} {{item.startTime}}<block wx:if="{{item.endTime}}"> - {{item.endTime}}</block><block wx:if="{{item.coach}}"> · {{item.coach}}</block><block wx:if="{{item.hasReminder}}"> · 🔔 已开提醒</block>
      </view>
      <view class="row-acts">
        <view wx:if="{{item.booked}}" class="act act-cancel" hover-class="press" data-id="{{item.id}}" bindtap="tapCancelRow">取消预约</view>
        <view wx:else class="act act-book" hover-class="press" data-id="{{item.id}}" bindtap="tapBookRow">预约这节</view>
        <view wx:if="{{item.mine}}" class="act act-del" hover-class="press" data-id="{{item.id}}" bindtap="tapDeleteRow">删除这节课</view>
        <view wx:if="{{item.past}}" class="act-past">已结束</view>
      </view>
    </view>
  </view>

  <!-- 提醒设置 -->
  <view wx:if="{{tab === 'reminders'}}">
    <view wx:if="{{reminders.length === 0}}" class="empty">
      <view class="dancer-lg empty-dancer">
        <view class="d-head"></view>
        <view class="d-torso"></view>
        <view class="d-limb d-arm-l"></view>
        <view class="d-limb d-arm-r"></view>
        <view class="d-limb d-leg-l"></view>
        <view class="d-limb d-leg-r"></view>
      </view>
      <view class="empty-title">一个提醒都没设</view>
      <view class="empty-sub">看好课就开提醒，别迟到</view>
    </view>
    <view wx:for="{{reminders}}" wx:key="id" class="record-card">
      <view class="record-head">
        <text class="record-course">🔔 {{item.schedule.courseName}}</text>
      </view>
      <view class="record-meta">{{item.cityName}} · {{item.schedule.studio}}</view>
      <view class="record-meta">{{item.dateLabel}} {{item.schedule.startTime}}</view>
      <view class="remind-time">开课前 2 小时提醒（{{item.status}}）</view>
      <button class="close-remind" data-id="{{item.schedule.id}}" bindtap="closeReminder">关闭提醒</button>
    </view>
  </view>
</view>

<toast id="toast" />
