.body {
  padding: 20rpx 24rpx 60rpx;
}

/* 顶部 hero */
.hero {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-left: 10rpx solid #00f5d4;
  border-radius: 32rpx;
  padding: 30rpx 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.3);
}
.hero-tags {
  display: flex;
  align-items: center;
}
.hero-level {
  font-size: 30rpx;
  font-weight: 900;
  border-radius: 24rpx;
  padding: 6rpx 22rpx;
  letter-spacing: 2rpx;
}
.hero-level.beginner {
  color: #0e0e1c;
  background: #00f5d4;
}
.hero-level.intermediate {
  color: #0e0e1c;
  background: #ff6b35;
}
.hero-level.advanced {
  color: #ffffff;
  background: #7b2fbe;
}
.hero-level.all_levels {
  color: #0e0e1c;
  background: #a8adc2;
}
.hero-diff {
  margin-left: 14rpx;
  font-size: 26rpx;
  font-weight: 900;
  color: #a8adc2;
}
.hero-title {
  font-size: 48rpx;
  font-weight: 900;
  margin-top: 22rpx;
  letter-spacing: 2rpx;
}
.hero-studio {
  font-size: 28rpx;
  color: #ff6b35;
  font-weight: 900;
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}

/* 信息卡片 */
.info-card {
  background: #16213e;
  border-radius: 32rpx;
  padding: 8rpx 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.3);
}
.info-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.info-row:last-child {
  border-bottom: none;
}
.info-ico {
  width: 64rpx;
  flex-shrink: 0;
  font-size: 34rpx;
}
.info-main {
  flex: 1;
  min-width: 0;
}
.info-label {
  font-size: 22rpx;
  color: #a8adc2;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.info-val {
  font-size: 30rpx;
  font-weight: 900;
  margin-top: 6rpx;
}
/* 教练名可点 → 老师主页，箭头提示可跳转 */
.coach-arrow {
  display: inline-block;
  margin-left: 8rpx;
  color: #7b7f99;
  font-weight: 400;
}
.info-sub {
  font-size: 24rpx;
  color: #a8adc2;
  margin-top: 6rpx;
  font-weight: 700;
}
.coach-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #7b2fbe;
  border: 3rpx solid #00f5d4;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 900;
  flex-shrink: 0;
  overflow: hidden;
}

/* 头像图铺满圆形底托。aspectFill 裁中间 —— 老师上传的照片长宽比各异，
   直接铺会被压扁，裁成方的才像头像 */
.coach-pic {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

/* 预约进度条 */
.progress {
  height: 14rpx;
  background: #2a2a4a;
  border-radius: 8rpx;
  overflow: hidden;
  margin-top: 14rpx;
}
.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #00f5d4, #ff6b35);
  border-radius: 8rpx;
}

/* 按钮区 */
.actions {
  margin-top: 4rpx;
}
.action {
  width: 100%;
  margin-top: 18rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 18rpx 0;
  line-height: 1.6;
  font-weight: 900;
  letter-spacing: 1rpx;
}
.action.primary {
  background: linear-gradient(135deg, #ff6b35, #ff8a5c);
  color: #ffffff;
}
.action.primary[disabled] {
  color: #ffffff;
  background: linear-gradient(135deg, #ff6b35, #ff8a5c);
  opacity: 0.6;
}
.action.secondary {
  background: transparent;
  color: #00f5d4;
  border: 2rpx solid #00f5d4;
}
.action.remind {
  background: transparent;
  color: #a8adc2;
  border: 2rpx solid #2b3050;
}
.action.remind.on {
  color: #00f5d4;
  border-color: #00f5d4;
  background: rgba(0, 245, 212, 0.08);
}
/* 约课提醒：橙色系，跟开课提醒的青色分开 —— 两件事，别让用户看混 */
.action.snipe {
  background: transparent;
  color: #ff9e6b;
  border: 2rpx solid rgba(255, 107, 53, 0.45);
}
.action.snipe.on {
  color: #ff8a5c;
  border-color: #ff6b35;
  background: rgba(255, 107, 53, 0.1);
}
/* 手机日历：中性色。它不是"我们"的提醒，是写进用户自己的日历，视觉上别抢主按钮 */
.action.cal {
  background: transparent;
  color: #9aa3c0;
  border: 2rpx solid #2b3050;
}

/* ── 约课提醒弹层 ── */
.sn-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.62);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sn-sheet {
  width: 100%;
  box-sizing: border-box;
  background: #1f2033;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
}
.sn-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #ffffff;
}
.sn-sub {
  font-size: 24rpx;
  color: #7f88a3;
  margin-top: 8rpx;
}
.sn-hint {
  font-size: 23rpx;
  color: #ff9e6b;
  line-height: 1.55;
  background: rgba(255, 107, 53, 0.1);
  border-left: 6rpx solid rgba(255, 107, 53, 0.55);
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin-top: 20rpx;
}
.sn-row {
  display: flex;
  margin-top: 24rpx;
}
/* ⚠ picker 里是原生控件，必须给明确高度：只写 padding 在真机上会被压成一条线 */
.sn-pick {
  height: 96rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid #2b3050;
  border-radius: 18rpx;
  padding: 0 24rpx;
  margin-right: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.sn-pick-label {
  font-size: 21rpx;
  color: #6b7391;
  line-height: 1.2;
}
.sn-pick-val {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 900;
  line-height: 1.3;
  margin-top: 4rpx;
}
.sn-tip {
  font-size: 22rpx;
  color: #6b7391;
  line-height: 1.6;
  margin-top: 20rpx;
}
/* 「同时写进手机日历」开关行已随约课提醒的日历联动一起撤掉（2026-09-30） */
.sn-actions {
  display: flex;
  margin-top: 28rpx;
}
.sn-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 900;
  margin-right: 16rpx;
}
.sn-btn:last-child {
  margin-right: 0;
}
.sn-btn.ghost {
  background: transparent;
  color: #a8adc2;
  border: 2rpx solid #2b3050;
}
.sn-btn.del {
  background: transparent;
  color: #ff6b6b;
  border: 2rpx solid rgba(255, 107, 107, 0.45);
}
.sn-btn.main {
  background: linear-gradient(135deg, #ff6b35, #ff8a5c);
  color: #ffffff;
}
/* 取消预约：破坏性操作，红色描边 */
.action.danger {
  background: transparent;
  color: #ff6b6b;
  border: 2rpx solid rgba(255, 107, 107, 0.45);
}

/* 视频预告 */
.video-sec {
  margin-top: 36rpx;
}
.video-title {
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  margin-bottom: 18rpx;
}
.video-scroll {
  white-space: nowrap;
}
.video-empty {
  text-align: center;
  color: #a8adc2;
  padding: 40rpx 0;
  font-size: 26rpx;
  font-weight: 700;
}
.video-card {
  display: inline-block;
  width: 300rpx;
  margin-right: 20rpx;
  background: #16213e;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  overflow: hidden;
  vertical-align: top;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.3);
}
.video-thumb {
  width: 100%;
  height: 168rpx;
  background: #1a1a2e;
}
.video-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff6b35;
  font-size: 48rpx;
}
.video-txt {
  font-size: 26rpx;
  font-weight: 900;
  padding: 14rpx 16rpx 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.video-meta {
  font-size: 20rpx;
  color: #a8adc2;
  padding: 0 16rpx 14rpx;
  font-weight: 700;
}
/* 课程预告视频（舞室官方系统的直链，服务端按需回源换签名）。
   给黑底是刻意的：视频比例五花八门，contain 之后上下留白用黑色最自然。 */
.course-video {
  display: block;
  width: 100%;
  height: 380rpx;
  border-radius: 20rpx;
  background: #000;
  overflow: hidden;
}
/* 课程封面图（iWOD 系抓取自带；点按全屏预览） */
.course-cover {
  display: block;
  width: 100%;
  height: 340rpx;
  border-radius: 20rpx;
  background: #23263a;
}

/* 预约人数：真实数据来源标注 + 刷新入口 */
.live-tip {
  float: right;
  font-size: 22rpx;
  color: #00f5d4;
  font-weight: 900;
  padding: 4rpx 16rpx;
}
.room-tip {
  font-size: 22rpx;
  color: #a8adc2;
  font-weight: 700;
}
.info-val .info-sub {
  margin-top: 4rpx;
}
