<nav-bar title="课程详情" show-back="{{true}}" bind:top="onNavTop" />

<view class="body" wx:if="{{detail}}">
  <!-- 顶部：课程名 + 等级标签 -->
  <view class="hero">
    <view class="hero-tags">
      <view class="hero-level {{diffClass}}">{{levelLabel}}</view>
      <view class="hero-diff">{{diffLabel}}</view>
    </view>
    <view class="hero-title">{{detail.courseName}}</view>
    <view class="hero-studio">{{detail.studio.name}}</view>
  </view>

  <!-- 课程信息卡片 -->
  <view class="info-card">
    <view class="info-row">
      <view class="info-ico">🎓</view>
      <view
        class="info-main"
        hover-class="press"
        data-name="{{coachName}}"
        data-city-id="{{cityId}}"
        bindtap="goCoach"
      >
        <view class="info-label">教练</view>
        <view class="info-val">
          {{coachName}}<text wx:if="{{coachName && coachName !== '待定'}}" class="coach-arrow">›</text>
        </view>
      </view>
      <!-- 有头像就显示头像，没有（或加载失败）退回首字母占位。
           头像来自各平台 CDN，域名不可控，binderror 兜底是必须的 -->
      <view class="coach-avatar">
        <image
          wx:if="{{coachAvatar}}"
          class="coach-pic"
          src="{{coachAvatar}}"
          mode="aspectFill"
          binderror="onCoachAvatarError"
        />
        <text wx:else>{{coachInitial}}</text>
      </view>
    </view>

    <view class="info-row">
      <view class="info-ico">🕐</view>
      <view class="info-main">
        <view class="info-label">时间</view>
        <view class="info-val">{{dateLabel}}</view>
        <view class="info-sub">{{timeLabel}}</view>
      </view>
    </view>

    <view class="info-row">
      <view class="info-ico">📍</view>
      <view class="info-main">
        <view class="info-label">地点</view>
        <view class="info-val">{{detail.studio.name}}</view>
        <view wx:if="{{detail.studio.address}}" class="info-sub">{{detail.studio.address}}</view>
      </view>
    </view>

    <view wx:if="{{roomName}}" class="info-row">
      <view class="info-ico">🚪</view>
      <view class="info-main">
        <view class="info-label">场地</view>
        <view class="info-val">{{roomName}}</view>
      </view>
    </view>

    <view class="info-row">
      <view class="info-ico">👥</view>
      <view class="info-main">
        <view class="info-label">
          预约人数
          <text class="live-tip" bindtap="onTapRefreshLive">{{refreshing ? "刷新中…" : "刷新"}}</text>
        </view>
        <view wx:if="{{bookedNum != null}}" class="info-val">
          {{shownCount}} / {{capacity}} 人
          <text class="room-tip">（还差 {{capacity - shownCount > 0 ? capacity - shownCount : 0}} 人满班）</text>
        </view>
        <view wx:elif="{{bookedCount > 0}}" class="info-val">{{bookedCount}} / {{capacity}} 人</view>
        <view wx:else class="info-val">{{bookedNum === 0 ? "0 / " + capacity + " 人" : "该舞室未公开"}}</view>
        <view wx:if="{{bookedNum != null}}" class="progress">
          <view class="progress-bar" style="width: {{progress}}%;"></view>
        </view>
        <view class="info-sub">{{bookMeta}}</view>
      </view>
    </view>
  </view>

  <!-- 按钮区 -->
  <view class="actions">
    <button
      class="action primary"
      hover-class="press"
      bindtap="goBook"
      disabled="{{busy || bookingStatus === 'CONFIRMED'}}"
    >{{bookingStatus === 'CONFIRMED' ? '✅ 已预约' : bookLabel}}</button>
    <button
      class="action secondary"
      hover-class="press"
      bindtap="markBooked"
      disabled="{{busy || bookingStatus === 'CONFIRMED'}}"
    >我已约好</button>
    <button class="action remind {{reminded ? 'on' : ''}}" hover-class="press" bindtap="toggleRemind" disabled="{{busy}}">
      {{reminded ? '已开启开课提醒' : '开启开课提醒'}}
    </button>
    <!--
      约课提醒：单独的入口，因为它的时刻来源跟开课提醒完全不同。
      门店课表可能提前一周就出来了，但真正能约是临近那几天的某个点，
      「几点开放预约」各家舞室自己定、没有平台接口给这个值，只能用户自己填。
    -->
    <button class="action snipe {{snipeRemindAt ? 'on' : ''}}" hover-class="press" bindtap="openSnipe" disabled="{{busy}}">
      ⏰ {{snipeLabel}}
    </button>
    <button class="action cal" hover-class="press" bindtap="addToCalendar" disabled="{{busy}}">
      📅 加入手机日历
    </button>
    <button wx:if="{{bookingStatus}}" class="action danger" hover-class="press" bindtap="cancelBooking" disabled="{{busy}}">取消预约</button>
  </view>

  <!-- 约课提醒设置：日期 + 时刻两个原生 picker -->
  <view wx:if="{{snipeOpen}}" class="sn-mask" bindtap="closeSnipe">
    <view class="sn-sheet" catchtap="noop">
      <view class="sn-title">⏰ 约课提醒</view>
      <view class="sn-sub">{{detail.courseName}} · {{detail.studio.name}}</view>
      <view class="sn-row">
        <picker mode="date" value="{{snipeDate}}" start="{{todayKey}}" bindchange="onSnipeDate">
          <view class="sn-pick">
            <view class="sn-pick-label">日期</view>
            <view class="sn-pick-val">{{snipeDate}}</view>
          </view>
        </picker>
        <picker mode="time" value="{{snipeTime}}" bindchange="onSnipeTime">
          <view class="sn-pick">
            <view class="sn-pick-label">时刻</view>
            <view class="sn-pick-val">{{snipeTime}}</view>
          </view>
        </picker>
      </view>
      <view class="sn-tip">到点会微信提醒你去约这节课，需要你点一下「允许通知」。</view>
      <view class="sn-actions">
        <button class="sn-btn ghost" hover-class="press" bindtap="closeSnipe">取消</button>
        <button wx:if="{{snipeRemindAt}}" class="sn-btn del" hover-class="press" bindtap="removeSnipe" disabled="{{busy}}">关掉提醒</button>
        <button class="sn-btn main" hover-class="press" bindtap="saveSnipe" disabled="{{busy}}">{{snipeRemindAt ? '改时间' : '设好'}}</button>
      </view>
    </view>
  </view>

  <!-- 课程预告视频（舞室官方系统里的预告片；菲体云系店铺抓得到） -->
  <view wx:if="{{nativeVideo}}" class="video-sec">
    <view class="video-title">🎬 课程预告</view>
    <video
      class="course-video"
      src="{{nativeVideo}}"
      object-fit="contain"
      show-center-play-btn
      show-fullscreen-btn
      show-play-btn
      enable-progress-gesture="{{false}}"
    />
  </view>

  <!-- 课程预告视频（海外平台店铺：YouTube 搜索结果） -->
  <view wx:if="{{showVideo && videos.length > 0}}" class="video-sec">
    <view class="video-title">🎬 课程预告</view>
    <scroll-view scroll-x class="video-scroll" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{videos}}"
        wx:key="videoId"
        class="video-card"
        hover-class="press"
        data-url="{{item.url}}"
        bindtap="openVideo"
      >
        <image
          wx:if="{{item.thumbnail}}"
          class="video-thumb"
          src="{{item.thumbnail}}"
          mode="aspectFill"
        />
        <view wx:else class="video-thumb video-ph">▶</view>
        <view class="video-txt">{{item.title}}</view>
        <view class="video-meta">{{item.platform}} · {{item.channelTitle}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 课程封面图（iWOD 系店铺抓取自带） -->
  <view wx:if="{{detail.coursePicUrl}}" class="video-sec">
    <view class="video-title">📷 课程预告图</view>
    <image
      class="course-cover"
      src="{{detail.coursePicUrl}}"
      mode="aspectFill"
      data-url="{{detail.coursePicUrl}}"
      bindtap="previewCover"
    />
  </view>
</view>

<toast id="toast" />
