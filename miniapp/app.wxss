page {
  background: #1a1a2e;
  font-size: 28rpx;
  color: #ffffff;
  font-family: "Arial Black", "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

button::after {
  border: none;
}

/* ===== 通用卡片 ===== */
.card {
  background: #16213e;
  border-radius: 32rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.3);
}

/* ===== 通用按钮 ===== */
.btn-pri {
  background: linear-gradient(135deg, #ff6b35, #ff8a5c);
  color: #ffffff;
  border-radius: 24rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}
.btn-pri[disabled] {
  opacity: 0.5;
  color: #ffffff;
}
.btn-sec {
  background: transparent;
  color: #00f5d4;
  border: 2rpx solid #00f5d4;
  border-radius: 24rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}
.btn-danger {
  background: #ff3b30;
  color: #ffffff;
  border-radius: 24rpx;
  font-weight: 900;
}

/* 点击反馈：缩放 0.95（配合 hover-class="press"） */
.press {
  transform: scale(0.95);
  opacity: 0.92;
  transition: transform 0.12s ease;
}

/* ===== 空状态 ===== */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;
}
.empty-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 2rpx;
}
.empty-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #aaaaaa;
}
.empty-btn {
  margin: 32rpx auto 0;
  width: 320rpx;
  padding: 18rpx 0;
  line-height: 1.6;
  font-size: 28rpx;
}

/* ===== 舞者剪影（纯 CSS 绘制，跳动的街舞小人） ===== */
/* 结构：d-head 头 + d-torso 躯干 + 四条 d-limb 肢体（以关节为轴旋转） */
.dancer-lg {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 28rpx;
  color: #00f5d4;
  animation: dancer-bob 0.9s ease-in-out infinite alternate;
}

.dancer-lg .d-head {
  position: absolute;
  left: 50%;
  top: 0;
  width: 30rpx;
  height: 30rpx;
  margin-left: -15rpx;
  border-radius: 50%;
  background: currentColor;
}

.dancer-lg .d-torso {
  position: absolute;
  left: 50%;
  top: 30rpx;
  width: 7rpx;
  height: 36rpx;
  margin-left: -3.5rpx;
  border-radius: 4rpx;
  background: currentColor;
}

.dancer-lg .d-limb {
  position: absolute;
  left: 50%;
  width: 7rpx;
  height: 34rpx;
  margin-left: -3.5rpx;
  border-radius: 4rpx;
  background: currentColor;
  transform-origin: 50% 0;
}

.dancer-lg .d-arm-l,
.dancer-lg .d-arm-r {
  top: 36rpx;
}

.dancer-lg .d-leg-l,
.dancer-lg .d-leg-r {
  top: 66rpx;
}

.dancer-lg .d-arm-l {
  animation: dancer-arm-l 1.1s ease-in-out infinite alternate;
}
.dancer-lg .d-arm-r {
  animation: dancer-arm-r 1.1s ease-in-out infinite alternate;
}
.dancer-lg .d-leg-l {
  animation: dancer-leg-l 1.1s ease-in-out infinite alternate;
}
.dancer-lg .d-leg-r {
  animation: dancer-leg-r 1.1s ease-in-out infinite alternate;
}

/* 空状态用品牌紫，与加载中的霓虹青区分开 */
.empty-dancer {
  color: #9b5cff;
}

@keyframes dancer-bob {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(-8rpx);
  }
}
@keyframes dancer-arm-l {
  from {
    transform: rotate(130deg);
  }
  to {
    transform: rotate(166deg);
  }
}
@keyframes dancer-arm-r {
  from {
    transform: rotate(-166deg);
  }
  to {
    transform: rotate(-130deg);
  }
}
@keyframes dancer-leg-l {
  from {
    transform: rotate(10deg);
  }
  to {
    transform: rotate(32deg);
  }
}
@keyframes dancer-leg-r {
  from {
    transform: rotate(-32deg);
  }
  to {
    transform: rotate(-10deg);
  }
}

/* 霓虹文本 */
.neon-text {
  background: linear-gradient(90deg, #00f5d4, #ff6b35);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}