<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab {{selected === index ? 'on' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-icon">
      <block wx:if="{{item.isCenter}}">
        <view class="center-btn {{animating === index ? 'bounce' : ''}}">
          <view class="plus-h"></view>
          <view class="plus-v"></view>
        </view>
      </block>
      <view wx:else class="dancer {{animating === index ? 'bounce' : ''}}">
        <view class="d-head"></view>
        <view class="d-torso"></view>
        <view class="d-limb d-arm-l" style="transform: rotate({{item.pose.armL}}deg)"></view>
        <view class="d-limb d-arm-r" style="transform: rotate({{item.pose.armR}}deg)"></view>
        <view class="d-limb d-leg-l" style="transform: rotate({{item.pose.legL}}deg)"></view>
        <view class="d-limb d-leg-r" style="transform: rotate({{item.pose.legR}}deg)"></view>
      </view>
      <view wx:if="{{item.dot && badge}}" class="dot"></view>
    </view>
    <view class="tab-text {{selected === index ? 'on' : ''}}">{{item.text}}</view>
  </view>
</view>
