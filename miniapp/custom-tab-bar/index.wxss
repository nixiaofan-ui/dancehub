.tab-bar {
  position: fixed;
  left: 20px;
  right: 20px;
  bottom: 20px;
  height: 50px;
  background: rgba(20, 20, 30, 0.85);
  border-radius: 30px;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 6px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  z-index: 999;
}

.tab {
  flex: 1;
  height: 50px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  position: relative;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #888888;
  transition: color 0.2s;
}

.tab.on .tab-icon {
  color: #00f5d4;
}

/* 舞者剪影：头 + 躯干 + 四条肢体，全部由 div 绘制（无图片资源） */
.dancer {
  position: relative;
  width: 22px;
  height: 22px;
  opacity: 0.75;
  transition: opacity 0.2s;
}

.tab.on .dancer {
  opacity: 1;
}

.d-head {
  position: absolute;
  left: 50%;
  top: 0;
  width: 6px;
  height: 6px;
  margin-left: -3px;
  border-radius: 50%;
  background: currentColor;
}

.d-torso {
  position: absolute;
  left: 50%;
  top: 6px;
  width: 2.5px;
  height: 7.5px;
  margin-left: -1.25px;
  border-radius: 2px;
  background: currentColor;
}

/* 肢体：以关节（顶端中心）为轴旋转，靠 inline style 给不同 tab 设定姿势 */
.d-limb {
  position: absolute;
  left: 50%;
  width: 2.5px;
  height: 7px;
  margin-left: -1.25px;
  border-radius: 2px;
  background: currentColor;
  transform-origin: 50% 0;
}

.d-arm-l,
.d-arm-r {
  top: 7.5px;
}

.d-leg-l,
.d-leg-r {
  top: 13px;
}

.center-btn {
  position: relative;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b35, #ff8a5c);
  box-shadow: 0 2px 6px rgba(255, 107, 53, 0.45);
  transition: box-shadow 0.2s;
}

.tab.on .center-btn {
  box-shadow:
    0 0 0 3px rgba(0, 245, 212, 0.55),
    0 2px 6px rgba(255, 107, 53, 0.45);
}

.plus-h,
.plus-v {
  position: absolute;
  left: 50%;
  top: 50%;
  background: #ffffff;
  border-radius: 2px;
}

.plus-h {
  width: 10px;
  height: 2.5px;
  transform: translate(-50%, -50%);
}

.plus-v {
  width: 2.5px;
  height: 10px;
  transform: translate(-50%, -50%);
}

.tab-text {
  margin-top: 4px;
  font-size: 10px;
  font-weight: 400;
  color: #888888;
  transition: color 0.2s;
}

.tab-text.on {
  color: #00f5d4;
  font-weight: 700;
}

/* 切换弹性缩放动画 */
.bounce {
  animation: bounce 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes bounce {
  0% {
    transform: scale(1);
  }
  40% {
    transform: scale(1.3);
  }
  70% {
    transform: scale(0.9);
  }
  100% {
    transform: scale(1);
  }
}

/* 我的 Tab 红点角标（脉冲动画） */
.dot {
  position: absolute;
  top: -2px;
  right: -4px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ff4757;
  border: 2px solid rgba(20, 20, 30, 0.85);
  animation: pulse 1.6s ease-in-out infinite;
}

@keyframes pulse {
  0%,
  100% {
    box-shadow: 0 0 0 0 rgba(255, 71, 87, 0.6);
    transform: scale(1);
  }
  50% {
    box-shadow: 0 0 0 5px rgba(255, 71, 87, 0);
    transform: scale(1.15);
  }
}