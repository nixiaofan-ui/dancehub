.tab-bar {
  position: fixed;
  left: 20px;
  right: 20px;
  bottom: 20px;
  background: rgba(20, 20, 30, 0.85);
  border-radius: 30px;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 12px 6px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  z-index: 999;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 56px;
}

.tab-emoji {
  font-size: 34px;
  line-height: 1.2;
  opacity: 0.55;
  filter: grayscale(1);
  transition: all 0.2s;
}

.tab-emoji.on {
  opacity: 1;
  filter: none;
  transform: scale(1.18);
  text-shadow: 0 0 14px rgba(0, 245, 212, 0.55);
}

.tab-text {
  margin-top: 3px;
  font-size: 20px;
  font-weight: 700;
  color: #888888;
  transition: all 0.2s;
}

.tab-text.on {
  color: #00f5d4;
  font-weight: 900;
  font-size: 24px;
}

.tab.center {
  flex: none;
  margin-top: -30px;
  width: 68px;
  height: 68px;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b35, #ff8a5c);
  box-shadow: 0 8px 22px rgba(255, 107, 53, 0.5);
  transition: all 0.2s;
}

.tab.center.on {
  box-shadow:
    0 0 0 4px rgba(0, 245, 212, 0.55),
    0 8px 22px rgba(255, 107, 53, 0.5);
}

.center-btn {
  position: relative;
  width: 68px;
  height: 68px;
}

.plus-h,
.plus-v {
  position: absolute;
  left: 50%;
  top: 50%;
  background: #ffffff;
  border-radius: 4px;
}

.plus-h {
  width: 26px;
  height: 4px;
  transform: translate(-50%, -50%);
}

.plus-v {
  width: 4px;
  height: 26px;
  transform: translate(-50%, -50%);
}