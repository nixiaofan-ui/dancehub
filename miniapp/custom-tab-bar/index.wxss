.tab-bar {
  position: fixed;
  left: 20px;
  right: 20px;
  bottom: 20px;
  height: 50px;
  background: rgba(20, 20, 30, 0.85);
  border-radius: 30px;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 6px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  z-index: 999;
}

.tab {
  flex: 1;
  height: 50px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  position: relative;
  line-height: 1;
}

.tab-emoji {
  font-size: 22px;
  line-height: 1.2;
  opacity: 0.5;
  filter: grayscale(1);
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s;
}

.tab-emoji.on {
  opacity: 1;
  filter: none;
  text-shadow: 0 0 12px rgba(0, 245, 212, 0.55);
}

.tab-text {
  margin-top: 2px;
  font-size: 10px;
  font-weight: 400;
  color: #888888;
  transition: color 0.2s;
}

.tab-text.on {
  color: #00f5d4;
  font-weight: 700;
}

/* 中间「+ 发布」左右排列 */
.tab.center {
  flex-direction: row;
  justify-content: center;
}

.center-group {
  display: flex;
  align-items: center;
}

.center-btn {
  position: relative;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b35, #ff8a5c);
  box-shadow: 0 3px 10px rgba(255, 107, 53, 0.45);
  transition: box-shadow 0.2s;
}

.tab.center.on .center-btn {
  box-shadow:
    0 0 0 3px rgba(0, 245, 212, 0.55),
    0 3px 10px rgba(255, 107, 53, 0.45);
}

.plus-h,
.plus-v {
  position: absolute;
  left: 50%;
  top: 50%;
  background: #ffffff;
  border-radius: 2px;
}

.plus-h {
  width: 14px;
  height: 3px;
  transform: translate(-50%, -50%);
}

.plus-v {
  width: 3px;
  height: 14px;
  transform: translate(-50%, -50%);
}

.center-text {
  margin-left: 6px;
  font-size: 10px;
  font-weight: 400;
  color: #888888;
  transition: color 0.2s;
}

.center-text.on {
  color: #00f5d4;
  font-weight: 700;
}

/* 切换弹性缩放动画 */
.bounce {
  animation: bounce 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes bounce {
  0% {
    transform: scale(1);
  }
  40% {
    transform: scale(1.3);
  }
  70% {
    transform: scale(0.9);
  }
  100% {
    transform: scale(1);
  }
}

/* 我的 Tab 红点角标 */
.dot {
  position: absolute;
  top: -2px;
  right: -4px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ff4757;
  border: 2px solid rgba(20, 20, 30, 0.85);
}