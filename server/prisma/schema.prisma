generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Region {
  CN
  OVERSEAS
}

enum StudioPlatform {
  WECHAT
  NAVER
  INSTAGRAM
  YOUTUBE
  OTHER
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum BookingStatus {
  PENDING
  CONFIRMED
}

enum BookingMethod {
  JUMP
  MANUAL
}

enum ReminderType {
  LOCAL
  SUBSCRIBE
}

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
}

model City {
  id        Int      @id @default(autoincrement())
  region    Region
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  studios   Studio[]
  users     User[]

  @@unique([region, name])
}

model User {
  id         Int       @id @default(autoincrement())
  openid     String    @unique
  nickname   String?
  avatarUrl  String?
  homeCityId Int?
  homeCity   City?     @relation(fields: [homeCityId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  follows    Follow[]
  bookings   Booking[]
  reminders  Reminder[]
  blocks     CoachBlock[]
  favCoaches CoachFollow[]
  schedules  Schedule[]
}

/// 用户屏蔽的老师（产品文案叫「不想看」）。
/// 按「名字」屏蔽而不是按 coachId：同一个老师在不同门店是两条 Coach 记录，
/// 按 id 屏蔽只能屏蔽掉其中一家店的课，等于没屏蔽。
/// 代价是同名会被一起屏蔽 —— 对「不想再上到雷老师的课」这个诉求来说可以接受。
model CoachBlock {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  coachName String   @db.VarChar(191)
  createdAt DateTime @default(now())

  @@unique([userId, coachName])
  @@index([userId])
}

/// 用户标记「常看的老师」（产品文案：爱师）。
/// 与 CoachBlock 是一对反向偏好：那边是「别让我看见」，这边是「有他的课先给我看」。
/// 同样按 coachName 而不是 coachId —— 老师在不同门店是两条 Coach 记录，
/// 按 id 关注只能关注到其中一家店的课。
model CoachFollow {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  coachName String   @db.VarChar(191)
  createdAt DateTime @default(now())

  @@unique([userId, coachName])
  @@index([userId])
}

model Studio {
  id               Int            @id @default(autoincrement())
  cityId           Int
  city             City           @relation(fields: [cityId], references: [id])
  name             String
  address          String?
  contact          String?
  logoUrl          String?
  platform         StudioPlatform @default(WECHAT)
  // 该店官方约课小程序的 appId（iWOD 系有，菲体云系暂缺）
  // 用户点「跳转官方小程序预约」时 navigateToMiniProgram 用
  bookingMiniAppId String?
  // 官网/官方预约页地址。海外场馆（首尔等）没有微信小程序，
  // 「去预约」走 web-view 打开这个地址，而不是 navigateToMiniProgram。
  // 国内场馆一般为空（走小程序跳转）。
  officialUrl String?
  // 所在行政区（「海淀」「余杭」这种不带后缀的短名）。
  // 由 scripts/build-district-overrides.mjs 回源上游补的地址 + 店名尾巴抽出来，
  // 启动时 ensureDistrict() 回填。抽不到就是 null —— 别猜，宁可归到「未标注」。
  district         String?        @db.VarChar(32)
  // 经纬度（GCJ-02，和微信/腾讯地图同一套坐标系，前端直接算距离不用换算）。
  // 现阶段只有菲体云系能从上游直接拿到（门店清单的 lng_lat），其余平台要靠地址
  // 做地理编码才能补 —— 那要地图 key，先不上。抽不到就是 null：算不出距离的店
  // 一律排在有距离的后面，绝不编一个出来。
  lat              Float?
  lng              Float?
  status           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  coaches          Coach[]
  schedules        Schedule[]
  follows          Follow[]

  @@index([cityId])
}

model Coach {
  id        Int       @id @default(autoincrement())
  studioId  Int
  studio    Studio    @relation(fields: [studioId], references: [id])
  name      String
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  schedules Schedule[]

  @@index([studioId])
}

model Schedule {
  id           Int        @id @default(autoincrement())
  studioId     Int
  studio       Studio     @relation(fields: [studioId], references: [id])
  coachId      Int?
  coach        Coach?     @relation(fields: [coachId], references: [id])
  courseName   String
  difficulty   Difficulty @default(ALL_LEVELS)
  scheduleDate DateTime   @db.Date
  startTime    DateTime   @db.Time
  endTime      DateTime   @db.Time
  bookingUrl   String?
  capacity     Int        @default(30)
  // 舞室官方系统里的真实已约人数（非本小程序用户数）。
  // 抓取时从平台接口的「已约」字段取（iWOD reserved_num / 爱舞功 student_count /
  // 共享中街 reserveNum / …），配合 capacity（总容量）算出真实拥挤度。
  // null = 该平台不提供或未抓到，前端应显示「未知」而不是 0。
  bookedNum    Int?
  remark       String?
  // 课程封面图（iWOD 的 pic 字段；菲体云暂无）
  coursePicUrl String?
  // 课程预告视频的「取址」，形如 `fityun|11058641|34103272`；非空即代表有预告视频。
  // ⚠ 存的是「去哪儿取」而不是视频地址：菲体云返回的是腾讯云点播签名链接，
  //    签名 1 小时就过期，落库等于存死链。详情页打开时按需回源换新的。
  videoRef     String?
  // 录入人：null = 抓取来的公共课，所有人可见；有值 = 用户手录的课，仅本人可见。
  // 用「null 表示公共」而不是单独建一张私课表，是因为课表的主查询
  // （城市时间轴 / 多店合并 / 老师主页）都要同时吐两类课 ——
  // 一张表只多一个 OR 条件，分表则每个接口都得 union 一遍。
  ownerId      Int?
  owner        User?      @relation(fields: [ownerId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  bookings     Booking[]
  reminders    Reminder[]

  @@index([studioId, scheduleDate])
  @@index([ownerId])
}

model Booking {
  id         Int           @id @default(autoincrement())
  userId     Int
  user       User          @relation(fields: [userId], references: [id])
  scheduleId Int
  schedule   Schedule      @relation(fields: [scheduleId], references: [id])
  status     BookingStatus @default(PENDING)
  method     BookingMethod @default(JUMP)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([userId, scheduleId])
}

model Reminder {
  id         Int            @id @default(autoincrement())
  userId     Int
  user       User           @relation(fields: [userId], references: [id])
  scheduleId Int
  schedule   Schedule       @relation(fields: [scheduleId], references: [id])
  type       ReminderType   @default(LOCAL)
  subscribeTplId String?
  remindAt   DateTime
  status     ReminderStatus @default(PENDING)
  sentAt     DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([userId, scheduleId])
  @@index([scheduleId])
}

// 抓取状态（原 .crawl-state.json，容器文件系统易失，改为落库；
// 云托管定时触发器模式下跨重启保留 lastSuccessAt，避免每次触发全量重抓）
model CrawlState {
  id            String    @id // 抓取配置 id，如 box:123 / org:11000001
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  lastError     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Follow {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  studioId  Int
  studio    Studio   @relation(fields: [studioId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, studioId])
  @@index([studioId])
}

enum ReportStatus {
  PENDING
  DONE
  REJECTED
}

/// 用户提报「我要的舞室没有」。
/// 抓取只能覆盖用那几套 SaaS 的店，头部独立舞室永远有漏；
/// 与其我们自己猜，不如让用户直接告诉我们缺谁 —— 这份名单比任何爬虫都准。
model StudioReport {
  id        Int          @id @default(autoincrement())
  userId    Int?
  name      String       @db.VarChar(191)
  city      String?      @db.VarChar(191)
  contact   String?      @db.VarChar(191)
  comment   String?      @db.Text
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@index([status])
}