generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Region {
  CN
  OVERSEAS
}

enum StudioPlatform {
  WECHAT
  NAVER
  INSTAGRAM
  YOUTUBE
  OTHER
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum BookingStatus {
  PENDING
  CONFIRMED
}

enum BookingMethod {
  JUMP
  MANUAL
}

enum ReminderType {
  LOCAL
  SUBSCRIBE
}

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
}

model City {
  id        Int      @id @default(autoincrement())
  region    Region
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  studios   Studio[]
  users     User[]

  @@unique([region, name])
}

model User {
  id         Int       @id @default(autoincrement())
  openid     String    @unique
  nickname   String?
  avatarUrl  String?
  homeCityId Int?
  homeCity   City?     @relation(fields: [homeCityId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  follows    Follow[]
  bookings   Booking[]
  reminders  Reminder[]
}

model Studio {
  id               Int            @id @default(autoincrement())
  cityId           Int
  city             City           @relation(fields: [cityId], references: [id])
  name             String
  address          String?
  contact          String?
  logoUrl          String?
  platform         StudioPlatform @default(WECHAT)
  // 该店官方约课小程序的 appId（iWOD 系有，菲体云系暂缺）
  // 用户点「跳转官方小程序预约」时 navigateToMiniProgram 用
  bookingMiniAppId String?
  // 官网/官方预约页地址。海外场馆（首尔等）没有微信小程序，
  // 「去预约」走 web-view 打开这个地址，而不是 navigateToMiniProgram。
  // 国内场馆一般为空（走小程序跳转）。
  officialUrl String?
  status           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  coaches          Coach[]
  schedules        Schedule[]
  follows          Follow[]

  @@index([cityId])
}

model Coach {
  id        Int       @id @default(autoincrement())
  studioId  Int
  studio    Studio    @relation(fields: [studioId], references: [id])
  name      String
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  schedules Schedule[]

  @@index([studioId])
}

model Schedule {
  id           Int        @id @default(autoincrement())
  studioId     Int
  studio       Studio     @relation(fields: [studioId], references: [id])
  coachId      Int?
  coach        Coach?     @relation(fields: [coachId], references: [id])
  courseName   String
  difficulty   Difficulty @default(ALL_LEVELS)
  scheduleDate DateTime   @db.Date
  startTime    DateTime   @db.Time
  endTime      DateTime   @db.Time
  bookingUrl   String?
  capacity     Int        @default(30)
  remark       String?
  // 课程封面图（iWOD 的 pic 字段；菲体云暂无）
  coursePicUrl String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  bookings     Booking[]
  reminders    Reminder[]

  @@index([studioId, scheduleDate])
}

model Booking {
  id         Int           @id @default(autoincrement())
  userId     Int
  user       User          @relation(fields: [userId], references: [id])
  scheduleId Int
  schedule   Schedule      @relation(fields: [scheduleId], references: [id])
  status     BookingStatus @default(PENDING)
  method     BookingMethod @default(JUMP)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([userId, scheduleId])
}

model Reminder {
  id         Int            @id @default(autoincrement())
  userId     Int
  user       User           @relation(fields: [userId], references: [id])
  scheduleId Int
  schedule   Schedule       @relation(fields: [scheduleId], references: [id])
  type       ReminderType   @default(LOCAL)
  subscribeTplId String?
  remindAt   DateTime
  status     ReminderStatus @default(PENDING)
  sentAt     DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([userId, scheduleId])
  @@index([scheduleId])
}

// 抓取状态（原 .crawl-state.json，容器文件系统易失，改为落库；
// 云托管定时触发器模式下跨重启保留 lastSuccessAt，避免每次触发全量重抓）
model CrawlState {
  id            String    @id // 抓取配置 id，如 box:123 / org:11000001
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  lastError     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Follow {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  studioId  Int
  studio    Studio   @relation(fields: [studioId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, studioId])
  @@index([studioId])
}