# Server
PORT=3000
NODE_ENV=development

# MySQL (Docker Compose 默认)
DATABASE_URL="mysql://root:root123@localhost:3306/dancehub"

# Redis (Docker Compose 默认)
REDIS_URL="redis://localhost:6379"

# JWT 签名密钥（生产环境必须更换）
JWT_SECRET=change-me-in-production

# Admin 后台静态令牌（Admin 请求头 x-admin-token 使用）
ADMIN_TOKEN=admin123

# 微信小程序（留空时登录接口走 dev 降级模式）
WECHAT_APPID=
WECHAT_SECRET=